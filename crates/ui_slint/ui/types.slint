export struct PosterItem {
    title: string,
    subtitle: string,
    provider: string,
    url: string,
    poster: string,
    /// The provider's headers for the poster download, one `Name: value` per line.
    poster-headers: string,
    media-key: string,
    data: string,
    image: image,
    progress: float,
}

export struct ShelfSection {
    title: string,
    items: [PosterItem],
}

export struct SourceItem {
    label: string,
    detail: string,
    working: bool,
    selected: bool,
}

export struct EpisodeItem {
    name: string,
    code: string,
    data: string,
    watched: bool,
    season: int,
    /// Its place in the provider's full list (the shown list is filtered by season).
    index: int,
}

export struct PluginItem {
    name: string,
    detail: string,
    file-name: string,
    trusted: bool,
}

export struct SettingChoice {
    label: string,
    value: string,
}

export struct TrackChoice {
    label: string,
    id: int,
}

export struct RepositoryItem {
    name: string,
    url: string,
}

export struct AvailablePlugin {
    /// Identifies the plugin to the app: its repository and internal name.
    key: string,
    name: string,
    /// Version, language and repository.
    detail: string,
    description: string,
    installed: bool,
}
