export struct PosterItem {
    title: string,
    subtitle: string,
    provider: string,
    url: string,
    poster: string,
    /// The provider's headers for the poster download, one `Name: value` per line.
    poster-headers: string,
    media-key: string,
    data: string,
    image: image,
    progress: float,
}

export struct ShelfSection {
    title: string,
    items: [PosterItem],
}

/// One stream of the player's Sources menu.
export struct SourceItem {
    /// Its place in the open list (what switching takes).
    index: int,
    label: string,
    /// `HLS`, `DASH`, `MKV`, `Video`.
    kind: string,
    /// `1.3 GB`; empty when unknown.
    size: string,
    /// The preferred subtitle languages it offers (`EN`).
    flags: [string],
    checking: bool,
    working: bool,
    selected: bool,
}

/// A coloured stretch on the seek bar (intro, recap, credits, preview), as shares of its length.
export struct SeekMark {
    start: float,
    width: float,
    /// 0 intro, 1 recap, 2 credits, 3 preview.
    kind: int,
}

/// A toggle of a filter row (`1080p` with its count, or a subtitle language).
export struct FilterChip {
    label: string,
    count: string,
    on: bool,
}

/// The counts and toggles above the Sources list.
export struct SourceMenuInfo {
    /// Streams before any filter.
    total: int,
    resolution-shown: int,
    subtitle-shown: int,
    tiers: [FilterChip],
    subtitles: [FilterChip],
}

export struct EpisodeItem {
    name: string,
    code: string,
    data: string,
    /// Seen to 80 % or more.
    watched: bool,
    /// How far it was watched, 0..1.
    progress: float,
    description: string,
    season: int,
    /// Its place in the provider's full list (the shown list is filtered by season).
    index: int,
}

export struct PluginItem {
    name: string,
    detail: string,
    file-name: string,
    trusted: bool,
}

export struct SettingChoice {
    label: string,
    value: string,
}

/// One row of the player's Audio or Subtitles menu.
export struct TrackChoice {
    label: string,
    /// The player's id of the track; -1 for "Off".
    id: int,
    /// The preferred language it is in (`EN`); empty for the rest.
    flag: string,
    selected: bool,
}

export struct RepositoryItem {
    name: string,
    url: string,
    /// Host and added date summary (e.g. "raw.githubusercontent.com · Added 2026-11-19").
    detail: string,
    /// Plugin count badge text (e.g. "42 plugins"), empty while loading.
    plugin-count: string,
}

export struct AvailablePlugin {
    /// Identifies the plugin to the app: its repository and internal name.
    key: string,
    name: string,
    /// Version, language and repository.
    detail: string,
    description: string,
    installed: bool,
}
