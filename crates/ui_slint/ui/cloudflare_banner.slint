import { Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvButton } from "controls.slint";

/// A site's Cloudflare check, shown under the top bar without blocking the app.
/// `state`: 1 needs permission, 2 verifying, 3 verified, 4 failed.
export component CloudflareBanner inherits Rectangle {
    in property <int> state;
    in property <string> host;
    in property <string> message;
    in property <bool> can-retry;
    callback verify();
    callback dismiss();

    height: 54px;
    background: root.state == 3 ? #122922 : (root.state == 4 ? #2e161d : #151d30);
    accessible-role: AccessibleRole.text;
    accessible-label: text.text;

    HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        spacing: 12px;
        cross-axis-alignment: center;

        if root.state == 2: Spinner {
            width: 18px;
            height: 18px;
            indeterminate: true;
        }
        if root.state != 2: TvIcon {
            commands: root.state == 3 ? Icons.check : (root.state == 4 ? Icons.alert : Icons.shield);
            size: 18px;
            color: root.state == 3 ? Theme.ok : (root.state == 4 ? Theme.danger : Theme.accent-hi);
        }

        text := Text {
            text: root.state == 1 ? root.host + " needs a quick “verify you are human” check before it can be used."
                : root.state == 2 ? "Checking " + root.host + ". Open verification if the site needs your input."
                : root.state == 3 ? root.host + " is verified."
                : root.host + " could not be verified: " + root.message;
            color: Theme.text;
            font-size: 13.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.state == 1 || root.state == 2 || (root.state == 4 && root.can-retry): TvButton {
            text: root.state == 1 ? "Verify" : (root.state == 2 ? "Open verification" : "Try again");
            kind: "primary";
            compact: true;
            clicked => { root.verify(); }
        }
        TvButton {
            text: root.state == 1 ? "Not now" : "Dismiss";
            kind: "ghost";
            compact: true;
            clicked => { root.dismiss(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: 100%;
        background: root.state == 3 ? #3ecf8e44 : (root.state == 4 ? Theme.danger-border : Theme.border);
    }
}
