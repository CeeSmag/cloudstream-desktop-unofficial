import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { PosterItem } from "types.slint";

/// Full-bleed cinema poster tile with bright TV focus ring and ambient glow.
export component PosterTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> artwork;
    in property <float> progress: 0;
    in property <bool> focused: false;
    /// The context menu's remove entry ("Remove from Library"); empty for none.
    in property <string> remove-text: "";
    callback clicked();
    callback play-requested();
    callback bookmark-requested();
    callback remove-requested();

    width: 160px;
    height: 274px;
    background: transparent;

    // Hover / focus zoom by growing geometry (never `transform-scale`: FemtoVG skips it).
    property <length> grow: root.focused ? 7px : (touch.has-hover ? 4px : 0px);
    animate grow { duration: 150ms; easing: ease-out; }

    VerticalLayout {
        spacing: 8px;
        alignment: start;

        // Full-bleed artwork frame
        Rectangle {
            width: 160px;
            height: 224px;
            background: transparent;

            poster-frame := Rectangle {
                x: -root.grow;
                y: -root.grow;
                width: parent.width + 2 * root.grow;
                height: parent.height + 2 * root.grow;
                border-radius: Theme.radius;
                background: Theme.card;
                clip: true;
                border-width: root.focused ? 2.5px : (touch.has-hover ? 1.5px : 1px);
                border-color: root.focused ? Theme.focus-ring : (touch.has-hover ? Theme.border-hi : #ffffff14);
                drop-shadow-blur: root.focused ? 22px : (touch.has-hover ? 16px : 8px);
                drop-shadow-color: root.focused ? Theme.focus-glow : #00000099;

                if root.artwork.width > 1: Image {
                    width: 100%;
                    height: 100%;
                    source: root.artwork;
                    image-fit: cover;
                }
                if root.artwork.width <= 1: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(155deg, #161d2e 0%, #0c101a 100%);
                    TvIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        commands: Icons.film;
                        size: 36px;
                        color: #ffffff30;
                    }
                }

                // Bottom vignette + sleek progress bar for partially watched titles
                if root.progress > 0.01: Rectangle {
                    y: parent.height - 34px;
                    height: 34px;
                    width: 100%;
                    background: @linear-gradient(0deg, #000000cc 0%, transparent 100%);
                }
                if root.progress > 0.01: Rectangle {
                    x: 8px;
                    y: parent.height - 10px;
                    width: parent.width - 16px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff38;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: 100%;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
        }

        // Clean title & subtitle below the poster
        VerticalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.focused || touch.has-hover ? #ffffff : Theme.text;
                font-size: 13.5px;
                font-weight: root.focused ? 700 : 600;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: Theme.caption-size;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Open";
                activated => { root.clicked(); }
            }
            if root.remove-text != "": MenuItem {
                title: root.remove-text;
                activated => { root.remove-requested(); }
            }
        }
    }
}

/// The width and height a tile takes in a row or grid, gap included.
export global TileMetrics {
    out property <length> step: 172px;
    out property <length> row-step: 286px;
}

export component PosterRow inherits Flickable {
    in property <[PosterItem]> items: [];
    /// The tile the remote focuses (-1 = none in this row).
    in property <int> focused-index: -1;
    in property <string> remove-text: "";
    callback open-at(int);
    callback play-at(int);
    callback bookmark-at(int);
    callback remove-at(int);
    /// The row got the focus; its position in the window, to scroll it into view.
    callback focus-arrived(length, length);

    height: 294px;

    changed focused-index => {
        if self.focused-index >= 0 {
            self.content-x = clamp(
                (self.width - 160px) / 2 - self.focused-index * TileMetrics.step,
                min(0px, self.width - self.content-width),
                0px);
            root.focus-arrived(self.absolute-position.y, self.height);
        }
    }
    animate content-x { duration: 180ms; easing: ease-out; }

    HorizontalLayout {
        padding: 10px;
        spacing: Theme.space-2;
        for item[i] in root.items: PosterTile {
            title: item.title;
            subtitle: item.subtitle;
            artwork: item.image;
            progress: item.progress;
            focused: i == root.focused-index;
            remove-text: root.remove-text;
            clicked => { root.open-at(i); }
            play-requested => { root.play-at(i); }
            bookmark-requested => { root.bookmark-at(i); }
            remove-requested => { root.remove-at(i); }
        }
    }
}

/// Posters that wrap into rows and scroll vertically (Browse, Search, Library). `columns` comes
/// from the app (the same count its arrow keys move by), so wrapping and navigation agree.
export component PosterGrid inherits ScrollView {
    in property <[PosterItem]> items: [];
    in property <int> columns: 4;
    in property <int> focused-index: -1;
    in property <int> scroll-reset: 0;
    in property <string> remove-text: "";
    callback open-at(int);
    callback play-at(int);
    callback bookmark-at(int);
    callback remove-at(int);

    changed scroll-reset => {
        self.content-y = 0px;
    }

    changed focused-index => {
        if self.focused-index >= 0 {
            self.content-y = clamp(
                -(floor(self.focused-index / max(1, root.columns)) * TileMetrics.row-step) + 10px,
                min(0px, self.visible-height - self.content-height),
                0px);
        }
    }

    FlexboxLayout {
        x: 0px;
        width: root.columns * TileMetrics.step + 16px;
        height: max(self.preferred-height, root.visible-height);
        cross-axis-line-alignment: start;
        padding: 10px;
        spacing: Theme.space-2;
        for item[i] in root.items: PosterTile {
            title: item.title;
            subtitle: item.subtitle;
            artwork: item.image;
            progress: item.progress;
            focused: i == root.focused-index;
            remove-text: root.remove-text;
            clicked => { root.open-at(i); }
            play-requested => { root.play-at(i); }
            bookmark-requested => { root.bookmark-at(i); }
            remove-requested => { root.remove-at(i); }
        }
    }
}
