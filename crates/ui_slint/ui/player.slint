import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvBadge, TvProgressBar } from "controls.slint";
import { SeekMark, SeekPreview, SourceItem, SourceMenuInfo, TrackChoice } from "types.slint";
import {
    ChoicePanel, DragBar, PlayerActionButton, SkipPromptPill, VolumeCapsule
} from "player_controls.slint";
import { SourcePanel } from "source_panel.slint";

export component PlayerOverlay inherits Rectangle {
    in property <string> title: "";
    /// Active stream quality/kind badge shown in the top-right header (e.g. "1080p · HLS").
    in property <string> source-badge: "";
    in property <image> video-frame;
    in property <float> position-ms: 0;
    in property <float> duration-ms: 1;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> paused: false;
    /// "Loading stream…" or "Buffering 45%"; empty while the picture plays.
    in property <string> waiting-text: "";
    in property <bool> audio-only: false;
    /// The pop-up confirming the viewer's last action; a new count shows it again.
    in property <string> feedback-text: "";
    /// Action icon key for the pop-up ("play", "pause", "volume", "mute", "back", "forward", ...).
    in property <string> feedback-icon: "";
    /// A level bar under the pop-up (volume), 0..1; below 0 for none.
    in property <float> feedback-level: -1;
    in property <int> feedback-count: 0;
    /// How much of the stream is loaded, 0..1.
    in property <float> buffered-fraction: 0;
    /// Where the stream's chapters start, 0..1.
    in property <[float]> chapter-notches: [];
    in property <[SeekMark]> skip-marks: [];
    /// "Skip Intro", "Next episode"; empty for none.
    in property <string> skip-label: "";
    /// Changes with every new part of the video, so the button shows by itself again.
    in property <string> skip-key: "";
    in property <bool> has-next-episode: false;
    in property <bool> has-previous-episode: false;
    in property <float> volume: 100;
    in property <bool> fullscreen: false;
    in-out property <bool> show-sources: false;
    /// Open track chooser drawer: 0 none, 1 audio, 2 subtitles.
    in-out property <int> open-panel: 0;
    in-out property <bool> chrome-visible: true;
    in property <[SourceItem]> sources: [];
    in property <SourceMenuInfo> source-info;
    in property <bool> can-refresh: true;
    in property <[TrackChoice]> audio-tracks: [];
    in property <[TrackChoice]> subtitle-tracks: [];

    callback toggle-pause();
    /// Structured hover/drag preview over the seek bar (time, chapter, skip part).
    pure callback preview-seek(float) -> SeekPreview;
    callback seek-to(float);
    callback seek-by(float);
    callback set-volume(float);
    /// The wheel turned over the video (logical pixels, up positive).
    callback wheel-volume(float);
    callback close-player();
    callback leave-player();
    callback toggle-sources();
    callback refresh-sources();
    callback skip-segment();
    callback next-episode();
    callback previous-episode();
    callback select-source(int);
    callback toggle-tier(int);
    callback toggle-source-subtitle(int);
    callback select-audio(int);
    callback select-subtitle(int);
    callback toggle-fullscreen();

    property <float> last-nonzero-volume: 100;
    property <bool> any-drawer-open: root.open-panel != 0 || root.show-sources;
    property <bool> seek-dragging: false;
    property <bool> vol-dragging: false;
    property <bool> dragging-slider: root.seek-dragging || root.vol-dragging;

    pure function feedback-icon-path(name: string) -> string {
        if name == "play" { return Icons.play; }
        if name == "pause" { return Icons.pause; }
        if name == "volume" { return Icons.volume; }
        if name == "mute" { return Icons.volume-muted; }
        if name == "back" { return Icons.rotate-ccw; }
        if name == "forward" { return Icons.rotate-cw; }
        if name == "jump" { return Icons.skip-forward; }
        if name == "fullscreen" { return Icons.maximize; }
        if name == "windowed" { return Icons.minimize; }
        if name == "audio" { return Icons.audio; }
        if name == "subtitles" { return Icons.subtitles; }
        if name == "source" { return Icons.layers; }
        return "";
    }

    pure function feedback-icon-filled(name: string) -> bool {
        return name == "play" || name == "pause" || name == "jump";
    }

    background: #000000;
    accessible-role: AccessibleRole.main;
    forward-focus: keys;

    changed chrome-visible => {
        if !root.chrome-visible {
            root.seek-dragging = false;
            root.vol-dragging = false;
        }
    }

    changed volume => {
        if root.volume > 0 {
            root.last-nonzero-volume = root.volume;
        }
    }

    /// Shows the controls and restarts their 3 s hide countdown.
    function show-chrome() {
        root.chrome-visible = true;
        if hide-timer.running {
            hide-timer.restart();
        }
    }

    function nudge(delta-ms: float) {
        root.show-chrome();
        root.seek-by(delta-ms);
    }

    function toggle-mute() {
        root.show-chrome();
        if root.volume > 0 {
            root.last-nonzero-volume = root.volume;
            root.set-volume(0);
        } else {
            root.set-volume(root.last-nonzero-volume > 0 ? root.last-nonzero-volume : 100);
        }
    }

    function toggle-track-panel(panel: int) {
        root.show-chrome();
        if root.open-panel == panel {
            root.open-panel = 0;
        } else {
            root.show-sources = false;
            root.open-panel = panel;
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "k" { root.show-chrome(); root.toggle-pause(); return accept; }
            if event.text == Key.LeftArrow { root.nudge(-10000); return accept; }
            if event.text == Key.RightArrow { root.nudge(10000); return accept; }
            if event.text == Key.UpArrow { root.show-chrome(); root.set-volume(min(root.volume + 5, 130)); return accept; }
            if event.text == Key.DownArrow { root.show-chrome(); root.set-volume(max(root.volume - 5, 0)); return accept; }
            if event.text == "m" { root.toggle-mute(); return accept; }
            if event.text == "f" { root.toggle-fullscreen(); return accept; }
            if event.text == "s" && root.skip-label != "" { root.skip-segment(); return accept; }
            if event.text == "N" && root.has-next-episode { root.next-episode(); return accept; }
            if event.text == Key.Escape {
                if root.any-drawer-open {
                    root.open-panel = 0;
                    root.show-sources = false;
                    return accept;
                }
                if root.fullscreen { root.toggle-fullscreen(); return accept; }
                root.leave-player();
                return accept;
            }
            return reject;
        }
    }

    // Video frame surface
    video-area := TouchArea {
        mouse-cursor: root.chrome-visible ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.show-chrome(); }
        changed mouse-y => { root.show-chrome(); }
        clicked => {
            if root.any-drawer-open {
                root.open-panel = 0;
                root.show-sources = false;
                keys.focus();
                root.show-chrome();
                return;
            }
            keys.focus();
            root.show-chrome();
            root.toggle-pause();
        }
        double-clicked => {
            root.toggle-pause();
            root.toggle-fullscreen();
        }
        scroll-event(event) => {
            root.show-chrome();
            root.wheel-volume(event.delta-y / 1px);
            return accept;
        }
        Image {
            width: 100%;
            height: 100%;
            source: root.video-frame;
            image-fit: contain;
        }
    }

    // Audio-only obsidian cinema backdrop & card
    if root.audio-only: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-ambient;
        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Rectangle {
                width: 340px;
                background: #0b101cc4;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: #ffffff20;
                drop-shadow-blur: 28px;
                drop-shadow-color: #00000099;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 72px;
                        height: 72px;
                        border-radius: 36px;
                        background: Theme.accent-soft;
                        border-width: 1px;
                        border-color: Theme.accent-border;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #5b8cff55;
                        TvIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: Icons.audio;
                            size: 32px;
                            color: Theme.accent-hi;
                        }
                    }
                    if root.title != "": Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    TvBadge {
                        text: "Audio only";
                        tone: "accent";
                    }
                }
            }
        }
    }

    // Non-colliding translucent loading / buffering pill with indeterminate CloudStream Blue bar
    if root.waiting-text != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.chrome-visible ? 82px : 24px;
        height: 40px;
        width: max(180px, waiting-text.preferred-width + 44px);
        border-radius: 13px;
        background: #0b101c80;
        border-width: 1px;
        border-color: #5b8cff55;
        clip: true;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000055;
        animate y { duration: 180ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 3px;
            alignment: center;
            cross-axis-alignment: center;
            waiting-text := Text {
                text: root.waiting-text;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TvProgressBar {
            x: 0;
            y: parent.height - 3px;
            width: 100%;
            bar-height: 3px;
            indeterminate: true;
            fill: Theme.accent;
        }
    }

    // Ultra-translucent center action feedback OSD (matches old repo's see-through pop-up + icons)
    feedback := Rectangle {
        property <bool> shown: false;
        property <string> icon-cmd: root.feedback-icon-path(root.feedback-icon);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        height: 54px;
        width: feedback-row.preferred-width;
        border-radius: 16px;
        background: #080b1270;
        border-width: 1px;
        border-color: #ffffff22;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000088;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 220ms; }
        feedback-row := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            alignment: center;
            cross-axis-alignment: center;
            if feedback.icon-cmd != "": TvIcon {
                commands: feedback.icon-cmd;
                filled: root.feedback-icon-filled(root.feedback-icon);
                size: 22px;
                color: root.feedback-icon == "mute" ? Theme.danger : Theme.accent-hi;
            }
            Text {
                text: root.feedback-text;
                color: #ffffff;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.feedback-level >= 0: Rectangle {
                width: 108px;
                height: 6px;
                border-radius: 3px;
                background: #ffffff2c;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.feedback-level, 0, 1);
                    height: 100%;
                    border-radius: 3px;
                    background: @linear-gradient(90deg, #4b7cf5 0%, #7aa3ff 100%);
                }
            }
        }
    }
    feedback-timer := Timer {
        interval: 1000ms;
        running: false;
        triggered => {
            feedback.shown = false;
            self.running = false;
        }
    }
    changed feedback-count => {
        feedback.shown = true;
        feedback-timer.running = true;
        feedback-timer.restart();
    }

    // Translucent Top Header HUD
    if root.chrome-visible: Rectangle {
        y: 0;
        height: 86px;
        background: @linear-gradient(180deg, #080b128c 0%, #080b1230 62%, #080b1200 100%);
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 13px;
            cross-axis-alignment: center;

            PlayerActionButton {
                text: "Back";
                icon: Icons.back;
                kind: "glass";
                clicked => { root.leave-player(); }
            }

            Rectangle {
                width: 3px;
                height: 20px;
                border-radius: 1.5px;
                background: Theme.accent;
            }

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.source-badge != "": TvBadge {
                text: root.source-badge;
                tone: "accent";
            }
        }
    }

    // Soft Bottom Vignette + Airy Translucent Obsidian Glass Control Dock
    if root.chrome-visible: Rectangle {
        y: parent.height - self.height;
        height: 144px;
        background: @linear-gradient(0deg, #080b126e 0%, #080b1228 65%, #080b1200 100%);

        Rectangle {
            x: 24px;
            y: parent.height - self.height - 18px;
            width: parent.width - 48px;
            height: 104px;
            border-radius: 16px;
            background: #0b101c66;
            border-width: 1px;
            border-color: #ffffff20;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000048;
            // Clicks on the dock itself never toggle playback underneath.
            TouchArea {
                changed mouse-x => { root.show-chrome(); }
                changed mouse-y => { root.show-chrome(); }
            }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 9px;
                alignment: center;

                // Row 1: Scrubber timeline
                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.position-text;
                        color: Theme.text;
                        font-size: 12.5px;
                        font-weight: 700;
                        min-width: 44px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                    seek-bar := DragBar {
                        horizontal-stretch: 1;
                        buffered: root.buffered-fraction;
                        notches: root.chapter-notches;
                        marks: root.skip-marks;
                        preview: (self.hovering || self.dragging) && root.duration-ms > 1
                            ? root.preview-seek(self.drag-value * root.duration-ms)
                            : { time: "", chapter: "", part: "" };
                        value: root.duration-ms <= 1 ? 0 : root.position-ms / root.duration-ms;
                        changed dragging => { root.seek-dragging = self.dragging; }
                        committed(v) => { root.show-chrome(); root.seek-to(v * root.duration-ms); }
                    }
                    Text {
                        text: root.duration-text;
                        color: Theme.text-secondary;
                        font-size: 12.5px;
                        font-weight: 600;
                        min-width: 44px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                // Row 2: Grouped transport & utility controls
                HorizontalLayout {
                    spacing: 9px;
                    cross-axis-alignment: center;

                    PlayerActionButton {
                        text: root.paused ? "Play" : "Pause";
                        icon: root.paused ? Icons.play : Icons.pause;
                        icon-filled: true;
                        kind: "primary";
                        clicked => { root.show-chrome(); root.toggle-pause(); }
                    }

                    // Translucent transport capsule (−10s, +10s, optional Prev/Next episode)
                    Rectangle {
                        height: 36px;
                        width: transport-row.preferred-width;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: 10px;
                        background: #080b1255;
                        border-width: 1px;
                        border-color: #ffffff18;
                        transport-row := HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            cross-axis-alignment: center;
                            PlayerActionButton {
                                text: "10s";
                                icon: Icons.rotate-ccw;
                                accessible-name: "Rewind 10 seconds";
                                kind: "subtle";
                                compact: true;
                                clicked => { root.nudge(-10000); }
                            }
                            PlayerActionButton {
                                text: "10s";
                                icon: Icons.rotate-cw;
                                accessible-name: "Forward 10 seconds";
                                kind: "subtle";
                                compact: true;
                                clicked => { root.nudge(10000); }
                            }
                            if root.has-previous-episode || root.has-next-episode: Rectangle {
                                width: 1px;
                                height: 18px;
                                background: #ffffff1c;
                            }
                            if root.has-previous-episode: PlayerActionButton {
                                text: "Prev";
                                icon: Icons.skip-back;
                                icon-filled: true;
                                kind: "subtle";
                                compact: true;
                                clicked => { root.show-chrome(); root.previous-episode(); }
                            }
                            if root.has-next-episode: PlayerActionButton {
                                text: "Next";
                                icon: Icons.skip-forward;
                                icon-filled: true;
                                kind: "subtle";
                                compact: true;
                                clicked => { root.show-chrome(); root.next-episode(); }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    vol-capsule := VolumeCapsule {
                        volume: root.volume;
                        changed dragging => { root.vol-dragging = self.dragging; }
                        set-volume(v) => { root.show-chrome(); root.set-volume(v); }
                        toggle-mute => { root.toggle-mute(); }
                    }

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #ffffff1c;
                    }

                    PlayerActionButton {
                        text: "Audio";
                        icon: Icons.audio;
                        kind: root.open-panel == 1 ? "tonal" : "glass";
                        clicked => { root.toggle-track-panel(1); }
                    }
                    PlayerActionButton {
                        text: "Subtitles";
                        icon: Icons.subtitles;
                        kind: root.open-panel == 2 ? "tonal" : "glass";
                        clicked => { root.toggle-track-panel(2); }
                    }
                    PlayerActionButton {
                        text: "Sources";
                        icon: Icons.layers;
                        badge: root.source-info.total > 0 ? root.source-info.total : "";
                        kind: root.show-sources ? "tonal" : "glass";
                        clicked => {
                            root.show-chrome();
                            root.open-panel = 0;
                            root.toggle-sources();
                        }
                    }
                    PlayerActionButton {
                        icon: root.fullscreen ? Icons.minimize : Icons.maximize;
                        accessible-name: root.fullscreen ? "Exit fullscreen" : "Fullscreen";
                        kind: root.fullscreen ? "tonal" : "glass";
                        clicked => { root.show-chrome(); root.toggle-fullscreen(); }
                    }
                }
            }
        }
    }

    // Audio Track Drawer
    if root.open-panel == 1: ChoicePanel {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 138px;
        title: "Audio";
        icon: Icons.audio;
        choices: root.audio-tracks;
        picked(v) => { root.select-audio(v); root.open-panel = 0; }
        close => { root.open-panel = 0; }
    }

    // Subtitles Track Drawer
    if root.open-panel == 2: ChoicePanel {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 138px;
        title: "Subtitles";
        icon: Icons.subtitles;
        choices: root.subtitle-tracks;
        picked(v) => { root.select-subtitle(v); root.open-panel = 0; }
        close => { root.open-panel = 0; }
    }

    // Sources Drawer
    if root.show-sources: SourcePanel {
        x: parent.width - self.width - 24px;
        y: 80px;
        height: parent.height - 218px;
        sources: root.sources;
        info: root.source-info;
        can-refresh: root.can-refresh;
        refresh => { root.refresh-sources(); }
        pick(index) => { root.select-source(index); }
        toggle-tier(i) => { root.toggle-tier(i); }
        toggle-subtitle(i) => { root.toggle-source-subtitle(i); }
        close => { root.show-sources = false; }
    }

    // The skip button shows by itself for the first 5 s of its part, then with the controls,
    // and yields cleanly while any drawer is open so overlays never overlap.
    property <bool> skip-window: false;
    changed skip-key => {
        root.skip-window = root.skip-key != "";
        skip-timer.running = root.skip-window;
        if root.skip-window { skip-timer.restart(); }
    }
    skip-timer := Timer {
        interval: 5s;
        running: false;
        triggered => {
            root.skip-window = false;
            self.running = false;
        }
    }
    if root.skip-label != "" && !root.any-drawer-open && (root.skip-window || root.chrome-visible): SkipPromptPill {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - (root.chrome-visible ? 138px : 26px);
        label: root.skip-label;
        countdown-active: root.skip-window;
        triggered => { root.skip-segment(); }
    }

    hide-timer := Timer {
        interval: 3s;
        running: root.chrome-visible && !root.paused && !root.any-drawer-open && !root.dragging-slider;
        triggered => { root.chrome-visible = false; }
    }
}
