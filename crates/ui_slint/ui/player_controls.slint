import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvBadge, TvProgressBar } from "controls.slint";
import { SeekMark, SeekPreview, TrackChoice } from "types.slint";

/// Horizontal cinema scrubber / slider; follows `value` (0..1) until dragged and emits `committed`
/// on release (avoids `std-widgets` Slider overwriting its own binding after the first seek).
export component DragBar inherits Rectangle {
    in property <float> value;
    in property <brush> fill: @linear-gradient(90deg, #4f7cff 0%, #7aa3ff 100%);
    /// Track thickness at rest and while hovered/dragged.
    in property <length> rest-height: 7px;
    in property <length> hover-height: 10px;
    /// How much is loaded, 0..1 (seek bar); drawn lighter behind the position.
    in property <float> buffered: 0;
    /// Where chapters start, 0..1, drawn as crisp dark hairline dividers.
    in property <[float]> notches: [];
    /// Intro, recap, credits and preview stretches along the bar.
    in property <[SeekMark]> marks: [];
    /// Structured hover/drag preview (timestamp, chapter, skip part) above the pointer.
    in property <SeekPreview> preview;
    /// Keep the thumb visible at rest (false for seek bar, true for volume slider).
    in property <bool> show-resting-thumb: false;
    /// Use a compact solid CloudStream Blue thumb (volume slider) instead of a white glowing knob.
    in property <bool> accent-thumb: false;
    out property <bool> dragging: touch.pressed;
    out property <bool> hovering: touch.has-hover;
    out property <float> drag-value: clamp(touch.mouse-x / max(1px, root.width), 0, 1);
    callback committed(float);

    height: 26px;
    property <bool> active: touch.has-hover || root.dragging;
    property <float> shown: root.dragging ? root.drag-value : clamp(root.value, 0, 1);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.active ? root.hover-height : root.rest-height;
        border-radius: self.height / 2;
        background: root.active ? #ffffff36 : #ffffff2c;
        animate height, background { duration: 110ms; }

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.buffered, 0, 1);
            height: 100%;
            border-radius: parent.border-radius;
            background: #ffffff34;
        }
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: parent.border-radius;
            background: root.fill;
        }
        // Coloured stretches for Intro (amber), Recap (sky), Credits (emerald), Preview (fuchsia).
        for mark in root.marks: Rectangle {
            x: parent.width * mark.start;
            width: parent.width * mark.width;
            height: 100%;
            border-radius: 2px;
            background: mark.kind == 0 ? #fbbf24cc
                : mark.kind == 1 ? #38bdf8cc
                : mark.kind == 2 ? #34d399d4
                : #e879f9cc;
        }
        if touch.has-hover && !root.dragging: Rectangle {
            x: 0;
            width: parent.width * root.drag-value;
            height: 100%;
            border-radius: parent.border-radius;
            background: #ffffff22;
        }
        for notch in root.notches: Rectangle {
            x: parent.width * notch - 1px;
            width: 2px;
            height: 100%;
            background: #080b12e0;
        }
        // Crisp white vertical hover hairline tracking the pointer along the seek bar.
        if root.active && !root.accent-thumb: Rectangle {
            x: clamp(parent.width * root.drag-value - 1px, 0px, max(0px, parent.width - 2px));
            width: 2px;
            height: 100%;
            background: #ffffffd9;
        }
    }

    // Playhead / slider thumb (hover-only on seek bar, resting CloudStream Blue dot on volume).
    Rectangle {
        property <length> thumb-size: root.accent-thumb
            ? (root.active ? 14px : 12px)
            : (root.active ? 16px : 12px);
        x: clamp(parent.width * root.shown - self.width / 2, 0px, max(0px, parent.width - self.width));
        y: (parent.height - self.height) / 2;
        width: self.thumb-size;
        height: self.thumb-size;
        border-radius: self.thumb-size / 2;
        background: root.accent-thumb ? Theme.accent-hi : #ffffff;
        border-width: root.accent-thumb ? 0px : 2px;
        border-color: Theme.accent;
        drop-shadow-blur: root.accent-thumb ? 6px : 12px;
        drop-shadow-color: #5b8cffb3;
        opacity: root.show-resting-thumb || root.active ? 1 : 0;
        animate opacity, width, height { duration: 120ms; }
    }

    if root.active && root.preview.time != "": Rectangle {
        x: clamp(
            parent.width * root.drag-value - self.width / 2,
            4px,
            max(4px, parent.width - self.width - 4px)
        );
        y: -self.height - 10px;
        height: 30px;
        width: tip-row.preferred-width;
        border-radius: 9px;
        background: #080b12d9;
        border-width: 1px;
        border-color: #ffffff24;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000099;

        tip-row := HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 7px;
            alignment: center;
            cross-axis-alignment: center;
            Text {
                text: root.preview.time;
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.preview.chapter != "": Text {
                text: root.preview.chapter;
                color: Theme.accent-hi;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.preview.part != "": Text {
                text: "· " + root.preview.part;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.committed(root.drag-value);
            }
        }
    }
}

/// Borderless cinema icon/action button (`frosted`, `accent`, `active`).
export component PlayerActionButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> icon-filled: false;
    in property <string> accessible-name: "";
    /// `"frosted"` | `"accent"` | `"active"`
    in property <string> kind: "frosted";
    in property <length> size: 38px;
    in property <bool> loading: false;
    callback clicked();

    property <bool> is-accent: root.kind == "accent";
    property <bool> is-active: root.kind == "active";

    height: root.size;
    width: root.text != "" ? max(root.size, btn-row.preferred-width) : root.size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.is-accent ? 12px : 11px;
    background: root.is-accent ? (touch.pressed ? #4874e6 : (touch.has-hover ? Theme.accent-hi : Theme.accent))
        : root.is-active ? (touch.has-hover ? Theme.accent-hi : Theme.accent)
        : (touch.pressed ? #ffffff30 : (touch.has-hover ? #ffffff2c : #ffffff18));
    border-width: root.is-accent ? 0px : 1px;
    border-color: root.is-active ? Theme.accent-hi : (touch.has-hover ? #ffffff30 : #ffffff1c);
    drop-shadow-blur: root.is-accent ? 18px : 0px;
    drop-shadow-color: #5b8cff77;
    animate background, border-color { duration: 120ms; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-action-default => { root.clicked(); }

    btn-row := HorizontalLayout {
        padding-left: root.text != "" ? 12px : 0px;
        padding-right: root.text != "" ? 12px : 0px;
        spacing: 7px;
        alignment: center;
        cross-axis-alignment: center;

        if root.icon != "": TvIcon {
            commands: root.icon;
            filled: root.icon-filled;
            size: root.is-accent ? 18px : 17px;
            color: #ffffff;
        }
        if root.text != "": Text {
            text: root.text;
            color: #ffffff;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    if root.loading: Rectangle {
        property <float> phase: mod(animation-tick() / 1200ms, 1.0);
        x: parent.width - 10px;
        y: 4px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Theme.accent-hi;
        opacity: 0.4 + 0.6 * (1.0 - abs(self.phase * 2.0 - 1.0));
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Compact frosted volume pill matching the reference layout: mute icon + slim blue slider.
export component VolumeCapsule inherits Rectangle {
    in property <float> volume: 100;
    out property <bool> dragging: vol-bar.dragging;
    callback set-volume(float);
    callback toggle-mute();

    height: 38px;
    width: cap-row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 11px;
    background: #ffffff18;
    border-width: 1px;
    border-color: #ffffff1c;

    cap-row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: mute-touch.has-hover ? #ffffff1c : transparent;
            animate background { duration: 110ms; }
            accessible-role: AccessibleRole.button;
            accessible-label: root.volume <= 0 ? "Unmute" : "Mute";
            accessible-action-default => { root.toggle-mute(); }

            TvIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: root.volume <= 0 ? Icons.volume-muted
                    : root.volume < 50 ? Icons.volume-low
                    : Icons.volume;
                size: 16px;
                color: root.volume <= 0 ? Theme.danger : #e2e8f0;
            }
            mute-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-mute(); }
            }
        }

        vol-bar := DragBar {
            width: 96px;
            rest-height: 4px;
            hover-height: 5px;
            show-resting-thumb: true;
            accent-thumb: true;
            value: root.volume / 130;
            committed(v) => { root.set-volume(v * 130); }
        }
    }
}

/// Translucent obsidian track chooser dropdown (audio / subtitles).
/// Absorbs wheel scrolling when hovered so scrolling the list never changes volume underneath.
export component ChoicePanel inherits Rectangle {
    in property <string> title;
    in property <string> icon: "";
    in property <[TrackChoice]> choices;
    in property <bool> loading: false;
    in property <string> loading-text: "";
    callback picked(int);
    callback close();

    width: 320px;
    height: min(max(132px, root.choices.length * 46px + 88px + (root.loading ? 36px : 0px)), 460px);
    background: #0b101cd0;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: #ffffff22;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;

    // Blocks clicks and wheel events from leaking through to the video surface underneath.
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    VerticalLayout {
        padding: 15px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            if root.icon != "": Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent-border;
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: root.icon;
                    size: 15px;
                    color: Theme.accent-hi;
                }
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15.5px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.choices.length > 0: TvBadge {
                text: root.choices.length;
                tone: "neutral";
            }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: close-touch.has-hover ? #ffffff1c : transparent;
                animate background { duration: 110ms; }
                accessible-role: AccessibleRole.button;
                accessible-label: "Close " + root.title;
                accessible-action-default => { root.close(); }
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: Icons.close;
                    size: 14px;
                    color: close-touch.has-hover ? Theme.text : Theme.muted;
                }
                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.divider; }

        if root.loading: VerticalLayout {
            spacing: 5px;
            Text {
                text: root.loading-text != "" ? root.loading-text : "Loading…";
                color: Theme.accent-hi;
                font-size: 11.5px;
                font-weight: 600;
            }
            TvProgressBar {
                bar-height: 3px;
                indeterminate: true;
                fill: Theme.accent;
            }
        }

        if root.choices.length == 0 && !root.loading: Text {
            text: "None in this stream";
            color: Theme.muted;
            font-size: 13.5px;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                for choice in root.choices: Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    background: choice.selected ? Theme.accent-soft : (row.has-hover ? #ffffff14 : transparent);
                    border-width: choice.selected ? 1px : 0px;
                    border-color: Theme.accent-border;
                    animate background { duration: 110ms; }
                    accessible-role: AccessibleRole.button;
                    accessible-label: choice.label;
                    accessible-checked: choice.selected;
                    accessible-action-default => { root.picked(choice.id); }

                    if choice.selected: Rectangle {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: 20px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }

                    row := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(choice.id); }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            text: choice.label;
                            color: choice.selected ? Theme.accent-hi : Theme.text;
                            font-size: 13.5px;
                            font-weight: choice.selected ? 700 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if choice.flag != "": TvBadge {
                            text: choice.flag;
                            tone: choice.selected ? "accent" : "neutral";
                        }
                        if choice.selected: TvIcon {
                            commands: Icons.check;
                            size: 15px;
                            color: Theme.accent-hi;
                        }
                    }
                }
            }
        }
    }
}

/// Translucent obsidian skip CTA ("Skip Intro", "Next Episode") with CloudStream Blue countdown.
export component SkipPromptPill inherits Rectangle {
    in property <string> label;
    in property <bool> countdown-active: false;
    callback triggered();

    height: 44px;
    width: skip-row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 12px;
    background: skip-touch.has-hover ? #18233bd4 : #0b101ca8;
    border-width: 1px;
    border-color: skip-touch.has-hover ? Theme.accent-hi : Theme.accent-border;
    clip: true;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000070;
    animate background, border-color { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.triggered(); }

    // Bottom CloudStream Blue countdown bar draining during the 5 s auto-show window.
    Rectangle {
        x: 0;
        y: parent.height - 3px;
        height: 3px;
        width: root.countdown-active ? 0px : parent.width;
        background: @linear-gradient(90deg, #4f7cff 0%, #7aa3ff 100%);
        visible: root.countdown-active;
        animate width { duration: root.countdown-active ? 5s : 0ms; }
    }

    skip-row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 9px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: Theme.accent;
            TvIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: Icons.skip-forward;
                filled: true;
                size: 13px;
                color: #ffffff;
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            width: 21px;
            height: 21px;
            border-radius: 6px;
            background: #ffffff16;
            border-width: 1px;
            border-color: #ffffff22;
            Text {
                text: "S";
                color: Theme.text-secondary;
                font-size: 10.5px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    skip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.triggered(); }
    }
}
