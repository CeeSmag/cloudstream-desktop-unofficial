import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvBadge } from "controls.slint";
import { SeekMark, SeekPreview, TrackChoice } from "types.slint";

/// Horizontal cinema scrubber / slider; follows `value` (0..1) until dragged and emits `committed`
/// on release (avoids `std-widgets` Slider overwriting its own binding after the first seek).
export component DragBar inherits Rectangle {
    in property <float> value;
    in property <brush> fill: @linear-gradient(90deg, #4b7cf5 0%, #7aa3ff 100%);
    /// How much is loaded, 0..1 (seek bar); drawn lighter behind the position.
    in property <float> buffered: 0;
    /// Where chapters start, 0..1, drawn as hairline dividers.
    in property <[float]> notches: [];
    /// Intro, recap, credits and preview stretches along the bar.
    in property <[SeekMark]> marks: [];
    /// Structured hover/drag preview (timestamp, chapter, skip part) above the pointer.
    in property <SeekPreview> preview;
    /// Keep the thumb visible at rest; false keeps the seek bar minimal until hovered/dragged.
    in property <bool> show-resting-thumb: false;
    out property <bool> dragging: touch.pressed;
    out property <bool> hovering: touch.has-hover;
    out property <float> drag-value: clamp(touch.mouse-x / max(1px, root.width), 0, 1);
    callback committed(float);

    height: 26px;
    property <bool> active: touch.has-hover || root.dragging;
    property <float> shown: root.dragging ? root.drag-value : clamp(root.value, 0, 1);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.active ? 8px : 4.5px;
        border-radius: self.height / 2;
        background: root.active ? #ffffff34 : #ffffff26;
        animate height, background { duration: 110ms; }

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.buffered, 0, 1);
            height: 100%;
            border-radius: parent.border-radius;
            background: #ffffff32;
        }
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: parent.border-radius;
            background: root.fill;
        }
        // Coloured segment stretches remain distinguishable across the entire timeline.
        for mark in root.marks: Rectangle {
            x: parent.width * mark.start;
            width: parent.width * mark.width;
            height: 100%;
            border-radius: 2px;
            background: mark.kind == 0 ? #f5b942c0
                : mark.kind == 1 ? #38bdf8c0
                : mark.kind == 2 ? #3ecf8ec0
                : #e879f9c0;
        }
        if touch.has-hover && !root.dragging: Rectangle {
            x: 0;
            width: parent.width * root.drag-value;
            height: 100%;
            border-radius: parent.border-radius;
            background: #ffffff22;
        }
        for notch in root.notches: Rectangle {
            x: parent.width * notch - 1px;
            width: 2px;
            height: 100%;
            background: #080b12e6;
        }
        // Crisp white vertical cursor line tracking the pointer along the track.
        if root.active: Rectangle {
            x: clamp(parent.width * root.drag-value - 1px, 0px, max(0px, parent.width - 2px));
            width: 2px;
            height: 100%;
            background: #ffffffd9;
        }
    }

    // Playhead thumb fades in smoothly on hover/drag so the bar stays calm at rest.
    Rectangle {
        property <length> thumb-size: root.active ? 15px : 11px;
        x: clamp(parent.width * root.shown - self.width / 2, 0px, max(0px, parent.width - self.width));
        y: (parent.height - self.height) / 2;
        width: self.thumb-size;
        height: self.thumb-size;
        border-radius: self.thumb-size / 2;
        background: #ffffff;
        border-width: 2px;
        border-color: Theme.accent;
        drop-shadow-blur: 10px;
        drop-shadow-color: #5b8cffb3;
        opacity: root.show-resting-thumb || root.active ? 1 : 0;
        animate opacity, width, height { duration: 120ms; }
    }

    if root.active && root.preview.time != "": Rectangle {
        x: clamp(
            parent.width * root.drag-value - self.width / 2,
            4px,
            max(4px, parent.width - self.width - 4px)
        );
        y: -self.height - 10px;
        height: 30px;
        width: tip-row.preferred-width;
        border-radius: 9px;
        background: #080b12d4;
        border-width: 1px;
        border-color: #ffffff24;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000099;

        tip-row := HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 7px;
            alignment: center;
            cross-axis-alignment: center;
            Text {
                text: root.preview.time;
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.preview.chapter != "": Text {
                text: root.preview.chapter;
                color: Theme.accent-hi;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.preview.part != "": Text {
                text: "· " + root.preview.part;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.committed(root.drag-value);
            }
        }
    }
}

/// Translucent obsidian button for the player HUD (`primary`, `glass`, `tonal`, `subtle`).
export component PlayerActionButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> icon-filled: false;
    in property <string> badge: "";
    in property <string> accessible-name: "";
    /// `"glass"` | `"primary"` | `"tonal"` | `"subtle"`
    in property <string> kind: "glass";
    in property <bool> compact: false;
    callback clicked();

    property <bool> is-primary: root.kind == "primary";
    property <bool> is-tonal: root.kind == "tonal";
    property <bool> is-subtle: root.kind == "subtle";

    height: root.compact ? 32px : 36px;
    width: max(self.height, btn-row.preferred-width);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.is-primary ? 18px : 10px;
    background: root.is-primary ? (touch.pressed ? #dbe4ff : (touch.has-hover ? #ffffff : #f4f6fbeb))
        : root.is-tonal ? (touch.pressed ? #5b8cff44 : (touch.has-hover ? #5b8cff3a : #5b8cff2c))
        : root.is-subtle ? (touch.pressed ? #ffffff24 : (touch.has-hover ? #ffffff18 : transparent))
        : (touch.pressed ? #ffffff28 : (touch.has-hover ? #ffffff20 : #ffffff11));
    border-width: root.is-primary || root.is-subtle ? 0px : 1px;
    border-color: root.is-tonal ? Theme.accent-border : (touch.has-hover ? #ffffff2c : #ffffff18);
    drop-shadow-blur: root.is-primary && touch.has-hover ? 12px : 0px;
    drop-shadow-color: Theme.focus-glow;
    animate background, border-color { duration: 120ms; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-action-default => { root.clicked(); }

    btn-row := HorizontalLayout {
        padding-left: root.text != "" ? (root.compact ? 10px : 13px) : 9px;
        padding-right: root.text != "" ? (root.compact ? 10px : 13px) : 9px;
        spacing: 7px;
        alignment: center;
        cross-axis-alignment: center;

        if root.icon != "": TvIcon {
            commands: root.icon;
            filled: root.icon-filled;
            size: root.compact ? 14.5px : 15.5px;
            color: root.is-primary ? Theme.bg
                : root.is-tonal ? Theme.accent-hi
                : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.is-primary ? Theme.bg
                : root.is-tonal ? Theme.accent-hi
                : Theme.text;
            font-size: root.compact ? 12.5px : 13px;
            font-weight: root.is-primary || root.is-tonal ? 700 : 600;
            vertical-alignment: center;
        }
        if root.badge != "": Rectangle {
            height: 18px;
            width: badge-text.preferred-width + 10px;
            border-radius: 9px;
            background: root.is-tonal ? #5b8cff3d : #ffffff1c;
            badge-text := Text {
                text: root.badge;
                color: root.is-tonal ? Theme.accent-hi : Theme.text-secondary;
                font-size: 10.5px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Translucent volume capsule: clickable mute button, CloudStream Blue slider, and % readout.
export component VolumeCapsule inherits Rectangle {
    in property <float> volume: 100;
    out property <bool> dragging: vol-bar.dragging;
    callback set-volume(float);
    callback toggle-mute();

    height: 36px;
    width: cap-row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 10px;
    background: #080b1255;
    border-width: 1px;
    border-color: #ffffff18;

    cap-row := HorizontalLayout {
        padding-left: 5px;
        padding-right: 11px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: mute-touch.has-hover ? #ffffff1a : transparent;
            animate background { duration: 110ms; }
            accessible-role: AccessibleRole.button;
            accessible-label: root.volume <= 0 ? "Unmute" : "Mute";
            accessible-action-default => { root.toggle-mute(); }

            TvIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: root.volume <= 0 ? Icons.volume-muted
                    : root.volume < 50 ? Icons.volume-low
                    : Icons.volume;
                size: 15.5px;
                color: root.volume <= 0 ? Theme.danger : Theme.text-secondary;
            }
            mute-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-mute(); }
            }
        }

        vol-bar := DragBar {
            width: 84px;
            show-resting-thumb: false;
            value: root.volume / 130;
            committed(v) => { root.set-volume(v * 130); }
        }

        Text {
            text: Math.round(root.volume) + "%";
            color: root.volume <= 0 ? Theme.danger : Theme.text-secondary;
            font-size: 11.5px;
            font-weight: 600;
            min-width: 34px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

/// Translucent obsidian track chooser drawer (audio / subtitles).
/// Absorbs wheel scrolling when hovered so scrolling the list never changes volume underneath.
export component ChoicePanel inherits Rectangle {
    in property <string> title;
    in property <string> icon: "";
    in property <[TrackChoice]> choices;
    callback picked(int);
    callback close();

    width: 332px;
    height: min(max(132px, root.choices.length * 46px + 88px), 440px);
    background: #0b101ca8;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: #ffffff22;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000066;

    // Blocks clicks and wheel events from leaking through to the video surface underneath.
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    VerticalLayout {
        padding: 15px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            if root.icon != "": Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent-border;
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: root.icon;
                    size: 15px;
                    color: Theme.accent-hi;
                }
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15.5px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.choices.length > 0: TvBadge {
                text: root.choices.length;
                tone: "neutral";
            }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: close-touch.has-hover ? #ffffff1c : transparent;
                animate background { duration: 110ms; }
                accessible-role: AccessibleRole.button;
                accessible-label: "Close " + root.title;
                accessible-action-default => { root.close(); }
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: Icons.close;
                    size: 14px;
                    color: close-touch.has-hover ? Theme.text : Theme.muted;
                }
                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.divider; }

        if root.choices.length == 0: Text {
            text: "None in this stream";
            color: Theme.muted;
            font-size: 13.5px;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                for choice in root.choices: Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    background: choice.selected ? Theme.accent-soft : (row.has-hover ? #ffffff14 : transparent);
                    border-width: choice.selected ? 1px : 0px;
                    border-color: Theme.accent-border;
                    animate background { duration: 110ms; }
                    accessible-role: AccessibleRole.button;
                    accessible-label: choice.label;
                    accessible-checked: choice.selected;
                    accessible-action-default => { root.picked(choice.id); }

                    if choice.selected: Rectangle {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: 20px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }

                    row := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(choice.id); }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            text: choice.label;
                            color: choice.selected ? Theme.accent-hi : Theme.text;
                            font-size: 13.5px;
                            font-weight: choice.selected ? 700 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if choice.flag != "": TvBadge {
                            text: choice.flag;
                            tone: choice.selected ? "accent" : "neutral";
                        }
                        if choice.selected: TvIcon {
                            commands: Icons.check;
                            size: 15px;
                            color: Theme.accent-hi;
                        }
                    }
                }
            }
        }
    }
}

/// Translucent obsidian skip CTA ("Skip Intro", "Next Episode") with CloudStream Blue countdown.
export component SkipPromptPill inherits Rectangle {
    in property <string> label;
    in property <bool> countdown-active: false;
    callback triggered();

    height: 44px;
    width: skip-row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 13px;
    background: skip-touch.has-hover ? #18233bcc : #0b101c8c;
    border-width: 1.5px;
    border-color: skip-touch.has-hover ? Theme.accent-hi : Theme.accent-border;
    clip: true;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    animate background, border-color { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.triggered(); }

    // Bottom CloudStream Blue countdown bar draining during the 5 s auto-show window.
    Rectangle {
        x: 0;
        y: parent.height - 3px;
        height: 3px;
        width: root.countdown-active ? 0px : parent.width;
        background: @linear-gradient(90deg, #4b7cf5 0%, #7aa3ff 100%);
        visible: root.countdown-active;
        animate width { duration: root.countdown-active ? 5s : 0ms; }
    }

    skip-row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 9px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: Theme.accent;
            TvIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: Icons.skip-forward;
                filled: true;
                size: 13px;
                color: Theme.bg;
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            width: 21px;
            height: 21px;
            border-radius: 6px;
            background: #ffffff16;
            border-width: 1px;
            border-color: #ffffff22;
            Text {
                text: "S";
                color: Theme.text-secondary;
                font-size: 10.5px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    skip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.triggered(); }
    }
}
