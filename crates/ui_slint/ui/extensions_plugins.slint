import { Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AvailablePlugin, PluginItem } from "types.slint";
import { TvBadge, TvButton, TvSegmented, TvSelect, TvSwitch, TvTextInput } from "controls.slint";
import { Card, MutedLabel } from "widgets.slint";

/// The Plugins tab's search, filters, sort and paging (read by the app when `changed` fires).
export global PluginList {
    in-out property <string> search: "";
    /// "All languages", then the languages the plugins are in.
    in property <[string]> languages: ["All languages"];
    in-out property <string> language: "All languages";
    in property <[string]> sorts: ["Sort: Name", "Sort: Language", "Sort: Size", "Sort: Date added"];
    in-out property <string> sort: "Sort: Name";
    /// 0 all, 1 not installed, 2 installed.
    in-out property <int> view: 0;
    /// "12 of 340".
    in property <string> count-text: "";
    in property <bool> has-more: false;
    callback changed();
    callback more();
}

/// Reusable searchable, filterable, sortable plugin catalog card (used by PluginsTab & RepositoryDetailView).
export component PluginCatalogCard inherits Card {
    in property <string> search-placeholder: "Search by name, author, language or repository…";
    in-out property <string> search: "";
    in property <[string]> languages: ["All languages"];
    in-out property <string> language: "All languages";
    in property <[string]> sorts: ["Sort: Name", "Sort: Language", "Sort: Size", "Sort: Date added"];
    in-out property <string> sort: "Sort: Name";
    in-out property <int> view: 0;
    in property <string> count-text: "";
    in property <bool> has-more: false;
    in property <[AvailablePlugin]> items: [];
    in property <bool> loading: false;
    in property <string> busy-text: "";
    in property <string> empty-text: "No plugins found.";
    callback filter-changed();
    callback load-more();
    callback install(string);

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;
        TvTextInput {
            text <=> root.search;
            placeholder-text: root.search-placeholder;
            leading-icon: Icons.search;
            horizontal-stretch: 1;
            edited => { root.filter-changed(); }
        }
        TvSelect {
            width: 158px;
            model: root.languages;
            current-value <=> root.language;
            selected => { root.filter-changed(); }
        }
        TvSelect {
            width: 176px;
            model: root.sorts;
            current-value <=> root.sort;
            selected => { root.filter-changed(); }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;
        TvSegmented {
            model: ["All", "Not installed", "Installed"];
            current-value: root.view == 1 ? "Not installed" : (root.view == 2 ? "Installed" : "All");
            selected(choice) => {
                root.view = choice == "Not installed" ? 1 : (choice == "Installed" ? 2 : 0);
                root.filter-changed();
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.count-text != "": TvBadge {
            text: root.count-text;
            tone: "neutral";
        }
    }

    if root.loading: HorizontalLayout {
        spacing: 10px;
        alignment: start;
        padding-top: 4px;
        Spinner { width: 18px; height: 18px; indeterminate: true; }
        MutedLabel { text: "Loading the plugins your repositories offer…"; vertical-alignment: center; }
    }

    if !root.loading && root.items.length == 0: Rectangle {
        min-height: 60px;
        border-radius: 10px;
        background: #ffffff05;
        Text {
            text: root.empty-text;
            color: Theme.muted;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.items.length > 0: VerticalLayout {
        spacing: 6px;
        for plugin in root.items: Rectangle {
            min-height: plugin.description != "" ? 70px : 56px;
            border-radius: 10px;
            background: avail-hover.has-hover ? #ffffff0f : #ffffff06;
            border-width: 1px;
            border-color: #ffffff0d;
            animate background { duration: 120ms; }
            avail-hover := TouchArea { }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Text {
                        text: plugin.name;
                        color: Theme.text;
                        font-size: 14.5px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    MutedLabel {
                        text: plugin.detail;
                        overflow: elide;
                    }
                    if plugin.description != "": Text {
                        text: plugin.description;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                if plugin.installed: TvBadge {
                    text: "Installed";
                    tone: "ok";
                }
                if !plugin.installed: TvButton {
                    text: "Install";
                    icon: Icons.download;
                    kind: "primary";
                    compact: true;
                    enabled: root.busy-text == "";
                    clicked => { root.install(plugin.key); }
                }
            }
        }
    }

    if root.has-more: HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        TvButton {
            text: "Show more plugins";
            kind: "secondary";
            clicked => { root.load-more(); }
        }
    }
}

/// Settings > Extensions > Plugins tab: Installed plugins management card + Available catalog.
export component PluginsTab inherits VerticalLayout {
    in property <[PluginItem]> plugins: [];
    in property <[AvailablePlugin]> available: [];
    in property <int> total-repositories: 0;
    in property <string> busy-text: "";
    in property <bool> loading: false;
    callback install(string);
    callback set-trusted(string, bool);
    callback uninstall(string);

    spacing: Theme.space-3;
    alignment: start;

    Card {
        title: "Installed plugins";
        subtitle: "Manage sandbox trust and uninstall local extensions";
        icon: Icons.shield;

        if root.plugins.length == 0: Rectangle {
            min-height: 54px;
            border-radius: 10px;
            background: #ffffff05;
            Text {
                text: "No plugins installed yet.";
                color: Theme.muted;
                font-size: 13.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.plugins.length > 0: VerticalLayout {
            spacing: 6px;
            for plugin in root.plugins: Rectangle {
                min-height: 60px;
                border-radius: 10px;
                background: inst-hover.has-hover ? #ffffff0f : #ffffff06;
                border-width: 1px;
                border-color: #ffffff0e;
                animate background { duration: 120ms; }
                inst-hover := TouchArea { }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            cross-axis-alignment: center;
                            Text {
                                text: plugin.name;
                                color: Theme.text;
                                font-size: 14.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if plugin.supported: TvBadge {
                                text: plugin.trusted ? "Trusted" : "Sandboxed";
                                tone: plugin.trusted ? "warn" : "ok";
                            }
                            if !plugin.supported: TvBadge {
                                text: "Not supported";
                                tone: "danger";
                            }
                        }
                        MutedLabel {
                            text: plugin.supported ? plugin.detail : plugin.note;
                            overflow: elide;
                        }
                    }
                    if plugin.supported: Text {
                        text: "Trust";
                        color: Theme.muted;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                    if plugin.supported: TvSwitch {
                        checked: plugin.trusted;
                        enabled: root.busy-text == "";
                        toggled => { root.set-trusted(plugin.file-name, self.checked); }
                    }
                    TvButton {
                        text: "Remove";
                        icon: Icons.trash;
                        kind: "danger";
                        compact: true;
                        enabled: root.busy-text == "";
                        clicked => { root.uninstall(plugin.file-name); }
                    }
                }
            }
        }
    }

    PluginCatalogCard {
        title: "Available plugins";
        subtitle: "Filter and install plugins offered across all repositories";
        icon: Icons.puzzle;
        search <=> PluginList.search;
        languages: PluginList.languages;
        language <=> PluginList.language;
        sorts: PluginList.sorts;
        sort <=> PluginList.sort;
        view <=> PluginList.view;
        count-text: PluginList.count-text;
        has-more: PluginList.has-more;
        items: root.available;
        loading: root.loading;
        busy-text: root.busy-text;
        empty-text: root.total-repositories == 0 ? "Add a repository in the Repositories tab to browse plugins."
            : PluginList.count-text == "" ? "Your repositories offer no plugins."
            : "No plugin matches that search or filter.";
        filter-changed => { PluginList.changed(); }
        load-more => { PluginList.more(); }
        install(key) => { root.install(key); }
    }
}
