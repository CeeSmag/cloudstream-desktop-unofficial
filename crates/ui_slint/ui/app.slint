import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvButton, TvProgressBar } from "controls.slint";
import {
    PosterItem, ShelfSection, SourceItem, SourceMenuInfo, FilterChip, SeekMark, SeekPreview, EpisodeItem, CastItem, DetailsMeta, PluginItem, TrackChoice,
    RepositoryItem, AvailablePlugin, PaginationItem
} from "types.slint";
import { HomePage } from "home.slint";
import { BrowsePage, SearchPage, LibraryPage } from "browse.slint";
import { SettingsPage } from "settings.slint";
import { DetailsOverlay } from "details.slint";
import { PlayerOverlay } from "player.slint";
import { CloudflareBanner } from "cloudflare_banner.slint";
import { TopBar } from "top_bar.slint";
import { Toast } from "toast.slint";

export { PluginList } from "extensions_plugins.slint";
export { RepoList, RepoDetail } from "extensions_repos.slint";
export { HomeExpanded } from "home.slint";
export { BrowseFilter } from "browse.slint";
export { PosterItem, ShelfSection, SourceItem, SourceMenuInfo, FilterChip, SeekMark, SeekPreview, EpisodeItem, CastItem, DetailsMeta, PluginItem, TrackChoice, RepositoryItem, AvailablePlugin, PaginationItem }

export component CloudStream inherits Window {
    title: "CloudStream";
    icon: @image-url("icon.png");
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.bg;
    forward-focus: main-focus;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <int> tab: 0;
    // Remote / keyboard focus: the row (-1 = top bar) and item, shown once a key was used.
    in-out property <int> focus-row: 0;
    in-out property <int> focus-col: 0;
    in-out property <bool> focus-visible: false;
    // Home's rows: the hero button, the continue-watching row, the first shelf (-1 = none).
    in-out property <int> hero-row: -1;
    in-out property <int> continue-row: -1;
    in-out property <int> shelf-row-base: 0;
    // Posters per row of the Browse / Search / Library grids (set from the window's width).
    in-out property <int> grid-columns: 4;
    // The window's width class, set from its real size (reading `width` here would loop).
    in-out property <bool> narrow-window: false;
    in-out property <bool> wide-window: false;
    // Raised to put the keyboard into the search box (Enter on it with the remote).
    in-out property <int> search-box-request: 0;
    // Raised to hand the remote to the Settings side menu.
    in-out property <int> settings-menu-request: 0;
    in-out property <bool> starting: true;
    in-out property <string> startup-status: "Loading extensions…";
    in-out property <float> startup-progress: 0.0;
    in-out property <bool> startup-indeterminate: true;
    in-out property <bool> home-loading: false;
    in-out property <string> notice: "";
    in-out property <string> status-line: "";
    in-out property <bool> open-busy: false;
    in-out property <string> open-status: "";
    in-out property <string> open-title: "Finding sources…";
    in-out property <float> open-fraction: 0;
    in-out property <bool> can-skip-checks: false;
    in-out property <string> search-query: "";
    in-out property <bool> search-loading: false;
    in-out property <string> search-message: "";
    in-out property <string> browse-kind: "movie";
    in-out property <bool> browse-loading: false;
    in-out property <string> browse-message: "";
    in-out property <string> update-badge: "";
    in-out property <int> hero-index: -1;
    in-out property <[string]> details-tags: [];
    in-out property <[CastItem]> details-cast-items: [];
    in-out property <string> play-label: "Play";
    in-out property <bool> show-secondary-play: false;
    in-out property <bool> details-loading: false;
    in-out property <image> details-poster;
    in-out property <image> details-backdrop;
    in-out property <string> details-resume-key: "";
    in-out property <string> details-title: "";
    in-out property <string> details-plot: "";
    in-out property <DetailsMeta> details-meta-info;
    in-out property <string> resume-label: "";
    in-out property <int> episode-columns: 3;
    in-out property <int> episode-total-count: 0;
    in-out property <bool> episodes-ascending: true;
    in-out property <string> active-season-label: "";
    in-out property <[string]> episode-macro-labels: [];
    in-out property <int> episode-active-macro: 0;
    in-out property <[string]> episode-range-labels: [];
    in-out property <int> episode-active-range: 0;
    in-out property <bool> player-open: false;
    in-out property <string> player-title: "";
    in-out property <int> player-open-panel: 0;
    in-out property <float> position-ms: 0;
    in-out property <float> duration-ms: 1;
    in-out property <bool> paused: false;
    in-out property <string> player-waiting: "";
    in-out property <bool> player-audio-only: false;
    in-out property <string> player-feedback: "";
    in-out property <string> player-feedback-icon: "";
    in-out property <float> player-feedback-level: -1;
    in-out property <int> player-feedback-count: 0;
    in-out property <float> buffered-fraction: 0;
    in property <[float]> chapter-notches: [];
    in property <[SeekMark]> skip-marks: [];
    in property <string> skip-label: "";
    in property <string> skip-key: "";
    in property <bool> has-next-episode: false;
    in property <bool> has-previous-episode: false;
    in-out property <bool> fullscreen: false;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <float> volume: 100;
    in-out property <image> video-frame;
    in-out property <bool> show-sources: false;
    in-out property <bool> sources-loading: false;
    in-out property <string> sources-status: "";
    in-out property <bool> subtitles-loading: false;
    in-out property <string> subtitles-status: "";
    // Cloudflare banner: 0 hidden, 1 needs permission, 2 verifying, 3 verified, 4 failed.
    in-out property <int> cf-state: 0;
    in-out property <bool> show-wipe-confirm: false;
    in-out property <string> cf-host: "";
    in-out property <string> cf-message: "";
    in-out property <int> settings-page-index: 0;
    in-out property <bool> debug-indicator-hovered: false;
    in-out property <int> diagnostics-focus-request: 0;
    in-out property <bool> pending-diagnostics-scroll: false;
    in-out property <int> updates-focus-request: 0;
    in-out property <bool> pending-updates-scroll: false;
    in-out property <int> extensions-tab: 0;
    in-out property <string> repo-url: "";
    in-out property <bool> player-chrome-visible: true;
    in-out property <int> season-filter: -1;

    in property <[ShelfSection]> home-shelves: [];
    in property <[PosterItem]> search-items: [];
    in property <[PosterItem]> browse-items: [];
    in property <[PosterItem]> library-items: [];
    in property <[PosterItem]> continue-items: [];
    in property <[EpisodeItem]> episodes: [];
    in property <[SourceItem]> sources: [];
    in property <SourceMenuInfo> source-info;
    in property <[PluginItem]> plugins: [];
    in property <[RepositoryItem]> repositories: [];
    in property <[AvailablePlugin]> available-plugins: [];
    in-out property <string> extensions-busy: "";
    in-out property <bool> plugins-loading: false;
    in-out property <bool> details-bookmarked: false;
    in property <[string]> providers: [];
    in property <[string]> cache-size-labels: [];
    in property <string> cache-size-value: "";
    in property <[string]> ahead-labels: [];
    in property <string> ahead-value: "";
    in property <[string]> storage-labels: [];
    in property <string> storage-value: "";
    in property <[string]> worker-labels: [];
    in property <string> worker-value: "";
    in property <[string]> audio-labels: [];
    in property <string> audio-value: "";
    in property <[string]> subtitle-labels: [];
    in property <string> subtitle-add-value: "";
    in property <[string]> subtitle-chosen: [];
    in property <bool> subtitle-full: false;
    in property <[string]> season-labels: [];
    in property <[TrackChoice]> audio-tracks: [];
    in property <[TrackChoice]> subtitle-tracks: [];
    in property <string> selected-provider: "";
    in property <bool> autoplay-next: true;
    in property <bool> skip-lookup: true;
    in property <bool> stream-proxy: true;
    in property <bool> auto-subtitles: true;
    in property <string> storage-label: "";
    in property <string> update-label: "";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <bool> update-can-apply: false;
    in property <bool> update-busy: false;
    in property <bool> update-downloading: false;
    in property <float> update-progress: 0;
    in property <string> hero-title: "";
    in property <string> hero-subtitle: "";
    in property <image> hero-image;

    callback select-tab(int);
    callback nav-key(string);
    callback search(string);
    callback open-shelf-item(int, int);
    callback open-search-hit(int);
    callback open-browse-hit(int);
    callback open-library-hit(int);
    callback play-details();
    callback resume-details();
    callback play-episode(int);
    callback close-details();
    callback skip-checks();
    callback refresh-sources();
    callback select-source(int);
    callback toggle-source-tier(int);
    callback toggle-source-subtitle(int);
    callback toggle-pause();
    pure callback preview-seek(float) -> SeekPreview;
    callback seek-to(float);
    callback seek-by(float);
    callback set-volume(float);
    callback wheel-volume(float);
    callback leave-player();
    callback toggle-sources();
    callback skip-segment();
    callback next-episode();
    callback previous-episode();
    callback load-browse(string);
    callback set-provider(string);
    callback install-repo(string);
    callback set-trusted(string, bool);
    callback uninstall-plugin(string);
    callback remove-repo(string);
    callback install-plugin(string);
    callback settings-page-shown(int);
    callback toggle-bookmark();
    callback set-autoplay(bool);
    callback set-skip-lookup(bool);
    callback set-stream-proxy(bool);
    callback set-auto-subtitles(bool);
    callback set-video-cache(string);
    callback set-ahead(string);
    callback set-storage-cap(string);
    callback set-worker-limit(string);
    callback set-audio(string);
    callback set-subtitle-add(string);
    callback remove-subtitle(int);
    callback clean-storage();
    callback confirm-wipe();
    callback check-updates();
    callback apply-update();
    callback open-logs();
    callback set-debug-logging(bool);
    in-out property <bool> debug-logging: false;
    in-out property <float> storage-fraction: 0;
    in-out property <bool> storage-over: false;
    in-out property <[string]> storage-rows: [];
    callback cf-verify();
    callback cf-dismiss();
    callback dismiss-notice();
    callback resume-hero();
    callback remove-continue(int);
    callback clear-continue();
    callback remove-bookmark(int);
    callback season-chosen(string);
    callback toggle-episode-sort();
    callback select-episode-macro(int);
    callback select-episode-range(int);
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback toggle-fullscreen();

    // Explicit origin prevents Slint 1.19 from merging child/conditional LayoutInfo into Window
    // (which would otherwise let a fixed-width overlay cap Window max-width and unmaximize it).
    main-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.starting { return reject; }
            if event.text == Key.UpArrow { root.nav-key("up"); return accept; }
            if event.text == Key.DownArrow { root.nav-key("down"); return accept; }
            if event.text == Key.LeftArrow { root.nav-key("left"); return accept; }
            if event.text == Key.RightArrow { root.nav-key("right"); return accept; }
            if event.text == Key.Return || event.text == " " { root.nav-key("enter"); return accept; }
            if event.text == Key.Escape || event.text == Key.Backspace { root.nav-key("back"); return accept; }
            if event.text == Key.Delete { root.nav-key("delete"); return accept; }
            return reject;
        }

        // Atmospheric obsidian gradient canvas
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg-ambient;
        }

        // Startup overlay: shown until the plugins and the first Home shelves have loaded.
        if starting: Rectangle {
            background: Theme.bg-ambient;
            VerticalLayout {
                alignment: center;
                spacing: 18px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 68px;
                        height: 68px;
                        border-radius: 20px;
                        background: @linear-gradient(135deg, #6d9bff 0%, #3d6ee8 100%);
                        drop-shadow-blur: 28px;
                        drop-shadow-color: #5b8cff66;
                        TvIcon {
                            x: (parent.width - self.width) / 2 + 2px;
                            y: (parent.height - self.height) / 2;
                            commands: Icons.play;
                            filled: true;
                            size: 32px;
                            color: #ffffff;
                        }
                    }
                }
                Text {
                    text: "CloudStream";
                    color: Theme.text;
                    font-size: 34px;
                    font-weight: 800;
                    letter-spacing: -0.4px;
                    horizontal-alignment: center;
                }
                Text {
                    text: startup-status;
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    TvProgressBar {
                        width: 320px;
                        bar-height: 6px;
                        progress: startup-progress;
                        indeterminate: startup-indeterminate;
                    }
                }
            }
        }

        // Main chrome
        if !starting: VerticalLayout {
            padding: 0;
            spacing: 0;

            TopBar {
                tab: root.tab;
                compact: root.narrow-window;
                wide: root.wide-window;
                focused-tab: root.focus-visible && root.focus-row == -1 ? root.focus-col : -1;
                provider: root.selected-provider;
                providers: root.providers;
                busy: root.home-loading || root.search-loading || root.browse-loading || root.details-loading
                    || root.open-busy || root.plugins-loading || root.extensions-busy != "";
                status: root.open-busy ? root.status-line : "";
                debug-logging: root.debug-logging;
                debug-hovered <=> root.debug-indicator-hovered;
                select-tab(i) => { select-tab(i); }
                set-provider(name) => { set-provider(name); }
                update: root.update-badge;
                update-clicked => {
                    root.settings-page-index = 0;
                    root.pending-updates-scroll = true;
                    root.updates-focus-request += 1;
                    select-tab(4);
                }
                open-debug-settings => {
                    root.debug-indicator-hovered = false;
                    root.settings-page-index = 0;
                    root.pending-diagnostics-scroll = true;
                    root.diagnostics-focus-request += 1;
                    select-tab(4);
                }
            }

            if cf-state != 0: CloudflareBanner {
                state: root.cf-state;
                host: root.cf-host;
                message: root.cf-message;
                verify => { cf-verify(); }
                dismiss => { cf-dismiss(); }
            }

            if details-title != "": DetailsOverlay {
                vertical-stretch: 1;
                title: details-title;
                loading: details-loading;
                poster: details-poster;
                backdrop: details-backdrop;
                resume-key: details-resume-key;
                focus-visible: root.focus-visible;
                focus-row: root.focus-row;
                focus-col: root.focus-col;
                bookmarked: details-bookmarked;
                toggle-bookmark => { toggle-bookmark(); }
                plot: details-plot;
                meta-info: details-meta-info;
                tags: details-tags;
                cast-items: details-cast-items;
                play-label: play-label;
                resume-label: resume-label;
                show-secondary-play: show-secondary-play;
                open-busy: open-busy;
                open-status: open-status;
                open-title: open-title;
                open-fraction: open-fraction;
                can-skip-checks: can-skip-checks;
                episodes: episodes;
                episode-total-count: episode-total-count;
                episode-columns: episode-columns;
                episodes-ascending: episodes-ascending;
                season-labels: season-labels;
                active-season-label: active-season-label;
                macro-labels: episode-macro-labels;
                active-macro: episode-active-macro;
                range-labels: episode-range-labels;
                active-range: episode-active-range;
                play => { play-details(); }
                resume => { resume-details(); }
                close => { close-details(); }
                skip-checks => { skip-checks(); }
                play-episode(i) => { play-episode(i); }
                season-chosen(v) => { season-chosen(v); }
                toggle-episode-sort => { toggle-episode-sort(); }
                select-episode-macro(m) => { select-episode-macro(m); }
                select-episode-range(r) => { select-episode-range(r); }
            }

            if details-title == "" && tab == 0: HomePage {
                continue-items: root.continue-items;
                shelves: root.home-shelves;
                provider-name: root.selected-provider;
                has-providers: root.providers.length > 0;
                loading: root.home-loading;
                hero-title: root.hero-title;
                hero-subtitle: root.hero-subtitle;
                hero-image: root.hero-image;
                columns: root.grid-columns;
                focus-visible: root.focus-visible;
                focus-row: root.focus-row;
                focus-col: root.focus-col;
                hero-row: root.hero-row;
                continue-row: root.continue-row;
                shelf-row-base: root.shelf-row-base;
                hero-index: root.hero-index;
                open-continue(i) => { open-library-hit(i); }
                open-shelf(s, i) => { open-shelf-item(s, i); }
                resume-hero => { resume-hero(); }
                remove-continue(i) => { remove-continue(i); }
                clear-continue => { clear-continue(); }
            }

            if details-title == "" && tab == 1: BrowsePage {
                items: root.browse-items;
                columns: root.grid-columns;
                focused-index: root.focus-visible && root.focus-row >= 0 ? root.focus-row * root.grid-columns + root.focus-col : -1;
                kind: root.browse-kind;
                loading: root.browse-loading;
                message: root.browse-message;
                load-kind(kind) => { load-browse(kind); }
                open-at(i) => { open-browse-hit(i); }
            }

            if details-title == "" && tab == 2: SearchPage {
                query <=> search-query;
                items: root.search-items;
                columns: root.grid-columns;
                focused-index: root.focus-visible && root.focus-row >= 1 ? (root.focus-row - 1) * root.grid-columns + root.focus-col : -1;
                search-focused: root.focus-visible && root.focus-row == 0;
                loading: root.search-loading;
                message: root.search-message;
                box-request: root.search-box-request;
                search(q) => { search(q); root.focus-main(); }
                open-at(i) => { open-search-hit(i); }
            }

            if details-title == "" && tab == 3: LibraryPage {
                items: root.library-items;
                columns: root.grid-columns;
                focused-index: root.focus-visible && root.focus-row >= 0 ? root.focus-row * root.grid-columns + root.focus-col : -1;
                open-at(i) => { open-library-hit(i); }
                remove-at(i) => { remove-bookmark(i); }
            }

            if details-title == "" && tab == 4: SettingsPage {
                page-index <=> settings-page-index;
                menu-request: root.settings-menu-request;
                cache-size-labels: root.cache-size-labels;
                cache-size-value: root.cache-size-value;
                ahead-labels: root.ahead-labels;
                ahead-value: root.ahead-value;
                storage-labels: root.storage-labels;
                storage-value: root.storage-value;
                worker-labels: root.worker-labels;
                worker-value: root.worker-value;
                provider-labels: root.providers;
                selected-provider: root.selected-provider;
                audio-labels: root.audio-labels;
                audio-value: root.audio-value;
                subtitle-labels: root.subtitle-labels;
                subtitle-add-value: root.subtitle-add-value;
                subtitle-chosen: root.subtitle-chosen;
                subtitle-full: root.subtitle-full;
                autoplay-next: root.autoplay-next;
                skip-lookup: root.skip-lookup;
                stream-proxy: root.stream-proxy;
                auto-subtitles: root.auto-subtitles;
                storage-label: root.storage-label;
                update-label: root.update-label;
                update-version: root.update-version;
                update-notes: root.update-notes;
                update-can-apply: root.update-can-apply;
                update-busy: root.update-busy;
                update-downloading: root.update-downloading;
                update-progress: root.update-progress;
                plugins: root.plugins;
                repositories: root.repositories;
                available-plugins: root.available-plugins;
                extensions-busy: root.extensions-busy;
                plugins-loading: root.plugins-loading;
                extensions-tab <=> root.extensions-tab;
                repo-url <=> root.repo-url;
                set-video-cache(v) => { set-video-cache(v); }
                set-ahead(v) => { set-ahead(v); }
                set-storage-cap(v) => { set-storage-cap(v); }
                set-worker-limit(v) => { set-worker-limit(v); }
                set-provider(v) => { set-provider(v); }
                set-audio(v) => { set-audio(v); }
                set-subtitle-add(v) => { set-subtitle-add(v); }
                remove-subtitle(i) => { remove-subtitle(i); }
                set-autoplay(v) => { set-autoplay(v); }
                set-skip-lookup(v) => { set-skip-lookup(v); }
                set-stream-proxy(v) => { set-stream-proxy(v); }
                set-auto-subtitles(v) => { set-auto-subtitles(v); }
                clean-storage => { clean-storage(); }
                wipe-data => { show-wipe-confirm = true; }
                check-updates => { check-updates(); }
                apply-update => { apply-update(); }
                open-logs => { open-logs(); }
                debug-logging: root.debug-logging;
                diagnostics-request: root.diagnostics-focus-request;
                pending-diagnostics-scroll <=> root.pending-diagnostics-scroll;
                updates-request: root.updates-focus-request;
                pending-updates-scroll <=> root.pending-updates-scroll;
                storage-fraction: root.storage-fraction;
                storage-over: root.storage-over;
                storage-rows: root.storage-rows;
                set-debug-logging(v) => { set-debug-logging(v); }
                install-repo(v) => { install-repo(v); }
                set-trusted(f, t) => { set-trusted(f, t); }
                uninstall-plugin(f) => { uninstall-plugin(f); }
                remove-repo(u) => { remove-repo(u); }
                install-plugin(k) => { install-plugin(k); }
                changed page-index => { settings-page-shown(self.page-index); }
            }
        }

        if player-open: PlayerOverlay {
            init => { self.focus(); }
            title: player-title;
            video-frame: video-frame;
            position-ms: position-ms;
            duration-ms: duration-ms;
            position-text: position-text;
            duration-text: duration-text;
            paused: paused;
            waiting-text: player-waiting;
            audio-only: player-audio-only;
            feedback-text: player-feedback;
            feedback-icon: player-feedback-icon;
            feedback-level: player-feedback-level;
            feedback-count: player-feedback-count;
            buffered-fraction: buffered-fraction;
            chapter-notches: chapter-notches;
            preview-seek(ms) => { return root.preview-seek(ms); }
            volume: volume;
            fullscreen: fullscreen;
            show-sources <=> show-sources;
            open-panel <=> player-open-panel;
            chrome-visible <=> player-chrome-visible;
            sources: sources;
            source-info: source-info;
            can-refresh: !sources-loading;
            sources-loading: sources-loading;
            sources-status: sources-status;
            subtitles-loading: subtitles-loading;
            subtitles-status: subtitles-status;
            toggle-tier(i) => { toggle-source-tier(i); }
            toggle-source-subtitle(i) => { toggle-source-subtitle(i); }
            audio-tracks: audio-tracks;
            subtitle-tracks: subtitle-tracks;
            toggle-pause => { toggle-pause(); }
            seek-to(v) => { seek-to(v); }
            seek-by(v) => { seek-by(v); }
            set-volume(v) => { set-volume(v); }
            wheel-volume(d) => { wheel-volume(d); }
            leave-player => { leave-player(); }
            toggle-sources => { toggle-sources(); }
            refresh-sources => { refresh-sources(); }
            skip-segment => { skip-segment(); }
            next-episode => { next-episode(); }
            previous-episode => { previous-episode(); }
            skip-marks: skip-marks;
            skip-label: skip-label;
            skip-key: skip-key;
            has-next-episode: has-next-episode;
            has-previous-episode: has-previous-episode;
            select-source(i) => { select-source(i); }
            select-audio(v) => { select-audio-track(v); }
            select-subtitle(v) => { select-subtitle-track(v); }
            toggle-fullscreen => { toggle-fullscreen(); }
        }

        if show-wipe-confirm: Rectangle {
            background: Theme.overlay-scrim;
            TouchArea { }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 460px;
                        background: Theme.panel-glass;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.danger-border;
                        drop-shadow-blur: 32px;
                        drop-shadow-color: #000000c8;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            HorizontalLayout {
                                spacing: 14px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 42px;
                                    height: 42px;
                                    border-radius: 12px;
                                    background: Theme.danger-soft;
                                    border-width: 1px;
                                    border-color: Theme.danger-border;
                                    TvIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.alert;
                                        size: 20px;
                                        color: Theme.danger;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Delete all saved data?";
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "This action cannot be undone.";
                                        color: Theme.danger;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                    }
                                }
                            }
                            Text {
                                text: "CloudStream will close now and permanently delete all local data, caches, installed plugins, repositories, settings, library bookmarks, and watch history.";
                                color: Theme.text-secondary;
                                font-size: 13.5px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: end;
                                padding-top: 4px;
                                TvButton {
                                    text: "Cancel";
                                    kind: "secondary";
                                    clicked => {
                                        show-wipe-confirm = false;
                                    }
                                }
                                TvButton {
                                    text: "Delete everything";
                                    icon: Icons.trash;
                                    kind: "danger";
                                    clicked => {
                                        show-wipe-confirm = false;
                                        confirm-wipe();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !starting && !player-open && root.debug-logging && root.debug-indicator-hovered: Rectangle {
            x: max(16px, root.width - self.width - Theme.page-pad);
            y: 78px;
            width: min(360px, root.width - 32px);
            height: debug-tip-body.preferred-height;
            border-radius: Theme.radius;
            background: Theme.panel-glass;
            border-width: 1px;
            border-color: #f5b94288;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000c0;
            debug-tip-body := VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.warn;
                    }
                    Text {
                        text: "Debug logging is active";
                        color: Theme.warn;
                        font-size: 13.5px;
                        font-weight: 700;
                    }
                }
                Text {
                    text: "CloudStream is recording detailed diagnostic traces (app, UI, player, streams, plugins, storage) to logs/debug/*.jsonl.";
                    color: Theme.text-secondary;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Resource impact: increases CPU and disk writes, and log files grow quickly (up to 20 MB per file). Leave off during normal use.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Click the Debug indicator to open Diagnostics settings.";
                    color: Theme.accent-hi;
                    font-size: 12px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
        }

        if notice != "": Toast {
            text: root.notice;
            area-width: root.width;
            area-height: root.height;
            dismissed => { dismiss-notice(); }
        }
    }

    /// Gives the keyboard / remote back to the screen navigation (after typing, or an overlay closed).
    public function focus-main() {
        main-focus.focus();
    }
}
