import { Button, ComboBox, LineEdit, Switch, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AvailablePlugin, PluginItem, RepositoryItem } from "types.slint";
import { ExtensionsPage } from "extensions_page.slint";
import { Card, SideNav, SettingRow, SectionTitle, MutedLabel } from "widgets.slint";

export component SettingsPage inherits Rectangle {
    in-out property <int> page-index: 0;
    /// Raised by the app to hand the remote to the side menu.
    in property <int> menu-request: 0;
    changed menu-request => { menu.focus(); }
    in property <[string]> cache-size-labels: [];
    in property <string> cache-size-value: "";
    in property <[string]> ahead-labels: [];
    in property <string> ahead-value: "";
    in property <[string]> storage-labels: [];
    in property <string> storage-value: "";
    in property <[string]> worker-labels: [];
    in property <string> worker-value: "";
    in property <[string]> provider-labels: [];
    in property <string> selected-provider: "";
    in property <[string]> audio-labels: [];
    in property <string> audio-value: "";
    in property <[string]> subtitle-labels: [];
    in property <string> subtitle-add-value: "";
    /// The chosen subtitle languages ("EN  English"), in the viewer's order.
    in property <[string]> subtitle-chosen: [];
    in property <bool> subtitle-full: false;
    in property <bool> keep-video-ready: true;
    in property <bool> autoplay-next: true;
    in property <bool> skip-lookup: true;
    in property <bool> stream-proxy: true;
    in property <bool> auto-subtitles: true;
    in property <bool> debug-logging: false;
    in property <string> storage-label: "";
    in property <string> update-label: "";
    in property <[PluginItem]> plugins: [];
    in property <[RepositoryItem]> repositories: [];
    in property <[AvailablePlugin]> available-plugins: [];
    in property <string> extensions-busy: "";
    in property <bool> plugins-loading: false;
    in-out property <string> repo-url: "";

    callback set-video-cache(string);
    callback set-ahead(string);
    callback set-storage-cap(string);
    callback set-worker-limit(string);
    callback set-provider(string);
    callback set-audio(string);
    callback set-subtitle-add(string);
    callback remove-subtitle(int);
    callback set-keep-ready(bool);
    callback set-autoplay(bool);
    callback set-skip-lookup(bool);
    callback set-stream-proxy(bool);
    callback set-auto-subtitles(bool);
    callback clean-storage();
    callback wipe-data();
    callback check-updates();
    callback apply-update();
    callback open-logs();
    callback set-debug-logging(bool);
    callback install-repo(string);
    callback set-trusted(string, bool);
    callback uninstall-plugin(string);
    callback remove-repo(string);
    callback install-plugin(string);

    background: transparent;
    accessible-role: AccessibleRole.main;

    HorizontalLayout {
        padding: Theme.page-pad;
        spacing: Theme.space-3;

        menu := SideNav {
            title: "Settings";
            model: ["General", "Preferences", "Extensions"];
            current-item <=> root.page-index;
        }

        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-3;

                SectionTitle { text: "Settings"; }

                if root.page-index == 0: VerticalLayout {
                    spacing: Theme.space-3;

                    Card {
                        title: "Video cache";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            SettingRow {
                                label: "Size";
                                ComboBox {
                                    model: root.cache-size-labels;
                                    current-value: root.cache-size-value;
                                    selected(value) => { root.set-video-cache(value); }
                                }
                            }
                            SettingRow {
                                label: "Read-ahead";
                                ComboBox {
                                    model: root.ahead-labels;
                                    current-value: root.ahead-value;
                                    selected(value) => { root.set-ahead(value); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "Storage";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            SettingRow {
                                label: "Limit";
                                ComboBox {
                                    model: root.storage-labels;
                                    current-value: root.storage-value;
                                    selected(value) => { root.set-storage-cap(value); }
                                }
                            }
                            MutedLabel { text: root.storage-label; }
                            Button { text: "Clean up storage now"; clicked => { root.clean-storage(); } }
                        }
                    }

                    Card {
                        title: "Plugin processes";
                        SettingRow {
                            label: "Resident workers";
                            ComboBox {
                                model: root.worker-labels;
                                current-value: root.worker-value;
                                selected(value) => { root.set-worker-limit(value); }
                            }
                        }
                    }

                    Card {
                        title: "Debug logging";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            SettingRow {
                                label: "Write detailed logs";
                                Switch {
                                    checked: root.debug-logging;
                                    toggled => { root.set-debug-logging(self.checked); }
                                }
                            }
                            MutedLabel {
                                text: "Writes step-by-step logs to separate files (logs/debug), one for each part of the app and the plugins, so odd behaviour can be traced. Leave it off normally: the files grow quickly.";
                                wrap: word-wrap;
                            }
                        }
                    }

                    Card {
                        title: "Updates & data";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            MutedLabel { text: root.update-label; }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Button { text: "Check for updates"; clicked => { root.check-updates(); } }
                                Button { text: "Apply update"; clicked => { root.apply-update(); } }
                                Button { text: "Open logs"; clicked => { root.open-logs(); } }
                            }
                            Button {
                                text: "Delete all saved data";
                                clicked => { root.wipe-data(); }
                            }
                        }
                    }
                }

                if root.page-index == 1: VerticalLayout {
                    spacing: Theme.space-3;

                    Card {
                        title: "Playback";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            SettingRow {
                                label: "Keep video ready when leaving";
                                Switch {
                                    checked: root.keep-video-ready;
                                    toggled => { root.set-keep-ready(self.checked); }
                                }
                            }
                            SettingRow {
                                label: "Autoplay next episode";
                                Switch {
                                    checked: root.autoplay-next;
                                    toggled => { root.set-autoplay(self.checked); }
                                }
                            }
                            SettingRow {
                                label: "Skip intro lookup";
                                Switch {
                                    checked: root.skip-lookup;
                                    toggled => { root.set-skip-lookup(self.checked); }
                                }
                            }
                            SettingRow {
                                label: "Local HLS helper (stream proxy)";
                                Switch {
                                    checked: root.stream-proxy;
                                    toggled => { root.set-stream-proxy(self.checked); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "Home provider";
                        ComboBox {
                            model: root.provider-labels;
                            current-value: root.selected-provider;
                            selected(value) => { root.set-provider(value); }
                        }
                    }

                    Card {
                        title: "Languages";
                        VerticalLayout {
                            spacing: Theme.space-2;
                            SettingRow {
                                label: "Preferred audio";
                                ComboBox {
                                    model: root.audio-labels;
                                    current-value: root.audio-value;
                                    selected(value) => { root.set-audio(value); }
                                }
                            }
                            SettingRow {
                                label: "Preferred subtitles";
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    if root.subtitle-chosen.length == 0: Text {
                                        text: "None: no language tags or subtitle filter in the player";
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    for chip[i] in root.subtitle-chosen: Rectangle {
                                        height: 32px;
                                        width: chip-row.preferred-width;
                                        border-radius: 8px;
                                        background: #5b8cff26;
                                        border-width: 1px;
                                        border-color: #5b8cff66;
                                        chip-row := HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 4px;
                                            spacing: 6px;
                                            Text {
                                                text: chip;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 24px;
                                                border-radius: 6px;
                                                background: remove-touch.has-hover ? #ffffff26 : transparent;
                                                accessible-role: AccessibleRole.button;
                                                accessible-label: "Remove " + chip;
                                                accessible-action-default => { root.remove-subtitle(i); }
                                                Text {
                                                    text: "✕";
                                                    color: Theme.muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                remove-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.remove-subtitle(i); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            SettingRow {
                                label: "Add a subtitle language";
                                ComboBox {
                                    enabled: !root.subtitle-full;
                                    model: root.subtitle-labels;
                                    current-value: root.subtitle-add-value;
                                    selected(value) => { root.set-subtitle-add(value); }
                                }
                            }
                            SettingRow {
                                label: "Auto-select subtitles";
                                Switch {
                                    checked: root.auto-subtitles;
                                    toggled => { root.set-auto-subtitles(self.checked); }
                                }
                            }
                        }
                    }
                }

                if root.page-index == 2: ExtensionsPage {
                    repositories: root.repositories;
                    available: root.available-plugins;
                    plugins: root.plugins;
                    busy-text: root.extensions-busy;
                    loading: root.plugins-loading;
                    repo-url <=> root.repo-url;
                    add-repository(url) => { root.install-repo(url); }
                    remove-repository(url) => { root.remove-repo(url); }
                    install(key) => { root.install-plugin(key); }
                    set-trusted(file, on) => { root.set-trusted(file, on); }
                    uninstall(file) => { root.uninstall-plugin(file); }
                }
            }
        }
    }
}
