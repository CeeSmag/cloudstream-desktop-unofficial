import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AvailablePlugin, PluginItem, RepositoryItem } from "types.slint";
import { ExtensionsPage } from "extensions_page.slint";
import { SettingsGeneralPage } from "settings_general.slint";
import { SettingsPreferencesPage } from "settings_preferences.slint";
import { SideNav } from "widgets.slint";

export component SettingsPage inherits Rectangle {
    in-out property <int> page-index: 0;
    /// Raised by the app to hand the remote to the side menu.
    in property <int> menu-request: 0;
    changed menu-request => { menu.focus(); }
    /// Raised when the viewer clicks the top-bar Debug indicator to jump straight to Diagnostics.
    in property <int> diagnostics-request: 0;
    in-out property <bool> pending-diagnostics-scroll: false;
    property <length> diagnostics-target-y: 0px;
    changed diagnostics-request => {
        if root.page-index == 0 && root.diagnostics-target-y > 0px {
            scroll.content-y = -max(0px, root.diagnostics-target-y - 24px);
            root.pending-diagnostics-scroll = false;
        }
    }
    changed diagnostics-target-y => {
        if root.pending-diagnostics-scroll && root.page-index == 0 && root.diagnostics-target-y > 0px {
            scroll.content-y = -max(0px, root.diagnostics-target-y - 24px);
            root.pending-diagnostics-scroll = false;
        }
    }
    /// Raised when the viewer clicks the top-bar Update pill to jump straight to App updates.
    in property <int> updates-request: 0;
    in-out property <bool> pending-updates-scroll: false;
    property <length> updates-target-y: 0px;
    changed updates-request => {
        if root.page-index == 0 && root.updates-target-y > 0px {
            scroll.content-y = -max(0px, root.updates-target-y - 24px);
            root.pending-updates-scroll = false;
        }
    }
    changed updates-target-y => {
        if root.pending-updates-scroll && root.page-index == 0 && root.updates-target-y > 0px {
            scroll.content-y = -max(0px, root.updates-target-y - 24px);
            root.pending-updates-scroll = false;
        }
    }
    in property <[string]> cache-size-labels: [];
    in property <string> cache-size-value: "";
    in property <[string]> ahead-labels: [];
    in property <string> ahead-value: "";
    in property <[string]> storage-labels: [];
    in property <string> storage-value: "";
    in property <[string]> worker-labels: [];
    in property <string> worker-value: "";
    in property <[string]> helper-idle-labels: [];
    in property <string> helper-idle-value: "";
    in property <[string]> perf-profile-labels: [];
    in property <string> perf-profile-value: "";
    in property <string> perf-pc-text: "";
    in property <string> perf-state-text: "";
    in property <string> perf-warning: "";
    in property <bool> perf-can-reset: false;
    in property <[string]> provider-labels: [];
    in property <string> selected-provider: "";
    in property <[string]> audio-labels: [];
    in property <string> audio-value: "";
    in property <[string]> subtitle-labels: [];
    in property <string> subtitle-add-value: "";
    /// The chosen subtitle languages ("EN  English"), in the viewer's order.
    in property <[string]> subtitle-chosen: [];
    in property <bool> subtitle-full: false;
    in property <bool> autoplay-next: true;
    in property <bool> skip-lookup: true;
    in property <bool> stream-proxy: true;
    in property <bool> auto-subtitles: true;
    in property <bool> debug-logging: false;
    /// How full the storage limit is (0..1), whether it is over, and the folders' sizes.
    in property <float> storage-fraction: 0;
    in property <bool> storage-over: false;
    in property <[string]> storage-rows: [];
    in property <string> storage-label: "";
    in property <string> update-label: "";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <bool> update-can-apply: false;
    in property <bool> update-busy: false;
    in property <bool> update-downloading: false;
    in property <float> update-progress: 0;
    in property <[PluginItem]> plugins: [];
    in property <[RepositoryItem]> repositories: [];
    in property <[AvailablePlugin]> available-plugins: [];
    in property <string> extensions-busy: "";
    in property <bool> plugins-loading: false;
    in-out property <int> extensions-tab: 0;
    in-out property <string> repo-url: "";

    callback set-video-cache(string);
    callback set-ahead(string);
    callback set-storage-cap(string);
    callback set-worker-limit(string);
    callback set-helper-idle(string);
    callback set-performance-profile(string);
    callback reset-performance();
    callback set-provider(string);
    callback set-audio(string);
    callback set-subtitle-add(string);
    callback remove-subtitle(int);
    callback set-autoplay(bool);
    callback set-skip-lookup(bool);
    callback set-stream-proxy(bool);
    callback set-auto-subtitles(bool);
    callback clean-storage();
    callback wipe-data();
    callback check-updates();
    callback apply-update();
    callback open-logs();
    callback set-debug-logging(bool);
    callback install-repo(string);
    callback set-trusted(string, bool);
    callback uninstall-plugin(string);
    callback remove-repo(string);
    callback install-plugin(string);

    background: transparent;
    accessible-role: AccessibleRole.main;

    HorizontalLayout {
        padding: Theme.page-pad;
        padding-top: Theme.space-3;
        spacing: 28px;

        menu := SideNav {
            title: "SETTINGS";
            model: ["General", "Preferences", "Extensions"];
            icons: [Icons.settings, Icons.sparkles, Icons.puzzle];
            subtitles: ["Cache, storage & system", "Playback & languages", "Repositories & plugins"];
            current-item <=> root.page-index;
        }

        scroll := ScrollView {
            horizontal-stretch: 1;

            VerticalLayout {
                width: min(max(scroll.visible-width - 16px, 420px), 920px);
                padding-left: 4px;
                padding-right: 16px;
                padding-bottom: 120px;
                alignment: start;

                if root.page-index == 0: general := SettingsGeneralPage {
                    changed diagnostics-y => { root.diagnostics-target-y = self.diagnostics-y; }
                    changed updates-y => { root.updates-target-y = self.updates-y; }
                    init => {
                        root.diagnostics-target-y = self.diagnostics-y;
                        root.updates-target-y = self.updates-y;
                    }
                    cache-size-labels: root.cache-size-labels;
                    cache-size-value: root.cache-size-value;
                    ahead-labels: root.ahead-labels;
                    ahead-value: root.ahead-value;
                    storage-labels: root.storage-labels;
                    storage-value: root.storage-value;
                    storage-fraction: root.storage-fraction;
                    storage-over: root.storage-over;
                    storage-rows: root.storage-rows;
                    storage-label: root.storage-label;
                    worker-labels: root.worker-labels;
                    worker-value: root.worker-value;
                    helper-idle-labels: root.helper-idle-labels;
                    helper-idle-value: root.helper-idle-value;
                    perf-profile-labels: root.perf-profile-labels;
                    perf-profile-value: root.perf-profile-value;
                    perf-pc-text: root.perf-pc-text;
                    perf-state-text: root.perf-state-text;
                    perf-warning: root.perf-warning;
                    perf-can-reset: root.perf-can-reset;
                    debug-logging: root.debug-logging;
                    update-label: root.update-label;
                    update-version: root.update-version;
                    update-notes: root.update-notes;
                    update-can-apply: root.update-can-apply;
                    update-busy: root.update-busy;
                    update-downloading: root.update-downloading;
                    update-progress: root.update-progress;
                    set-video-cache(v) => { root.set-video-cache(v); }
                    set-ahead(v) => { root.set-ahead(v); }
                    set-storage-cap(v) => { root.set-storage-cap(v); }
                    set-worker-limit(v) => { root.set-worker-limit(v); }
                    set-helper-idle(v) => { root.set-helper-idle(v); }
                    set-performance-profile(v) => { root.set-performance-profile(v); }
                    reset-performance() => { root.reset-performance(); }
                    clean-storage => { root.clean-storage(); }
                    set-debug-logging(v) => { root.set-debug-logging(v); }
                    open-logs => { root.open-logs(); }
                    check-updates => { root.check-updates(); }
                    apply-update => { root.apply-update(); }
                    wipe-data => { root.wipe-data(); }
                }

                if root.page-index == 1: SettingsPreferencesPage {
                    autoplay-next: root.autoplay-next;
                    skip-lookup: root.skip-lookup;
                    stream-proxy: root.stream-proxy;
                    auto-subtitles: root.auto-subtitles;
                    provider-labels: root.provider-labels;
                    selected-provider: root.selected-provider;
                    audio-labels: root.audio-labels;
                    audio-value: root.audio-value;
                    subtitle-labels: root.subtitle-labels;
                    subtitle-add-value: root.subtitle-add-value;
                    subtitle-chosen: root.subtitle-chosen;
                    subtitle-full: root.subtitle-full;
                    set-autoplay(v) => { root.set-autoplay(v); }
                    set-skip-lookup(v) => { root.set-skip-lookup(v); }
                    set-stream-proxy(v) => { root.set-stream-proxy(v); }
                    set-provider(v) => { root.set-provider(v); }
                    set-audio(v) => { root.set-audio(v); }
                    set-subtitle-add(v) => { root.set-subtitle-add(v); }
                    remove-subtitle(i) => { root.remove-subtitle(i); }
                    set-auto-subtitles(v) => { root.set-auto-subtitles(v); }
                }

                if root.page-index == 2: ExtensionsPage {
                    active-tab <=> root.extensions-tab;
                    repositories: root.repositories;
                    available: root.available-plugins;
                    plugins: root.plugins;
                    busy-text: root.extensions-busy;
                    loading: root.plugins-loading;
                    repo-url <=> root.repo-url;
                    add-repository(url) => { root.install-repo(url); }
                    remove-repository(url) => { root.remove-repo(url); }
                    install(key) => { root.install-plugin(key); }
                    set-trusted(file, on) => { root.set-trusted(file, on); }
                    uninstall(file) => { root.uninstall-plugin(file); }
                }
            }
        }
    }
}
