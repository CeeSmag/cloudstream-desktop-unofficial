    out property <string> shield: "M 12 3 L 19 6 V 12 C 19 16.5 15.8 19.6 12 21 C 8.2 19.6 5 16.5 5 12 V 6 Z";
    out property <string> globe: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 3.5 12 H 20.5 M 12 3 C 9.2 6.5 9.2 17.5 12 21 C 14.8 17.5 14.8 6.5 12 3";
    out property <string> link: "M 9.5 14.5 L 14.5 9.5 M 8 12 L 5.5 14.5 A 3.5 3.5 0 0 0 10.5 19.5 L 13 17 M 16 12 L 18.5 9.5 A 3.5 3.5 0 0 0 13.5 4.5 L 11 7";
