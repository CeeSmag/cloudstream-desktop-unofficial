import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { AvailablePlugin, RepositoryItem } from "types.slint";
import { TvBadge, TvButton, TvSelect, TvTextInput } from "controls.slint";
import { Card, MutedLabel, SettingDivider } from "widgets.slint";
import { PluginCatalogCard } from "extensions_plugins.slint";

/// The Repositories tab's search, sort and open callback.
export global RepoList {
    in-out property <string> search: "";
    in property <[string]> sorts: ["Sort: Date added", "Sort: Name"];
    in-out property <string> sort: "Sort: Date added";
    /// "3 of 8" when filtered, or "8 repositories".
    in property <string> count-text: "";
    in property <int> total-count: 0;
    callback changed();
    callback open(string);
}

/// Drill-down view for one clicked repository's plugins.
export global RepoDetail {
    /// Non-empty when a repository is open.
    in-out property <string> open-url: "";
    in property <string> name: "";
    /// e.g. "42 plugins · 5 installed".
    in property <string> summary: "";
    in-out property <string> search: "";
    in property <[string]> languages: ["All languages"];
    in-out property <string> language: "All languages";
    in property <[string]> sorts: ["Sort: Name", "Sort: Language", "Sort: Size", "Sort: Date added"];
    in-out property <string> sort: "Sort: Name";
    /// 0 all, 1 not installed, 2 installed.
    in-out property <int> view: 0;
    in property <string> count-text: "";
    in property <bool> has-more: false;
    in property <[AvailablePlugin]> plugins: [];
    callback changed();
    callback more();
    callback close();
}

/// Settings > Extensions > Repositories tab: add, search, sort, remove, or open a repository.
export component RepositoriesTab inherits VerticalLayout {
    in property <[RepositoryItem]> repositories: [];
    in property <string> busy-text: "";
    in-out property <string> repo-url: "";
    callback add-repository(string);
    callback remove-repository(string);

    spacing: Theme.space-3;
    alignment: start;

    Card {
        title: "Add repository";
        subtitle: "Paste a repo.json URL or short code to subscribe to new providers";
        icon: Icons.plus;

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            TvTextInput {
                text <=> root.repo-url;
                placeholder-text: "https://…/repo.json or short code";
                leading-icon: Icons.link;
                horizontal-stretch: 1;
                accepted => {
                    if root.repo-url != "" && root.busy-text == "" {
                        root.add-repository(root.repo-url);
                    }
                }
            }
            TvButton {
                text: "Add";
                icon: Icons.plus;
                kind: "primary";
                enabled: root.repo-url != "" && root.busy-text == "";
                clicked => { root.add-repository(root.repo-url); }
            }
        }
    }

    Card {
        title: "Your repositories";
        subtitle: "Select any repository to browse and install its plugins";
        icon: Icons.link;

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            TvTextInput {
                text <=> RepoList.search;
                placeholder-text: "Search repositories by name or URL…";
                leading-icon: Icons.search;
                horizontal-stretch: 1;
                edited => { RepoList.changed(); }
            }
            TvSelect {
                width: 186px;
                model: RepoList.sorts;
                current-value <=> RepoList.sort;
                selected => { RepoList.changed(); }
            }
            if RepoList.count-text != "": TvBadge {
                text: RepoList.count-text;
                tone: "neutral";
            }
        }

        if root.repositories.length == 0: Rectangle {
            min-height: 62px;
            border-radius: 10px;
            background: #ffffff05;
            Text {
                text: RepoList.total-count == 0
                    ? "No repositories added yet. Paste a repo.json URL above to get started."
                    : "No repository matches that search.";
                color: Theme.muted;
                font-size: 13.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.repositories.length > 0: VerticalLayout {
            spacing: 6px;
            padding-top: 2px;
            for repository in root.repositories: Rectangle {
                min-height: 62px;
                border-radius: 12px;
                background: open-touch.has-hover ? #ffffff11 : #ffffff06;
                border-width: 1px;
                border-color: open-touch.has-hover ? Theme.border-hi : #ffffff0e;
                animate background, border-color { duration: 120ms; }

                HorizontalLayout {
                    padding-right: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    // Clickable main surface opens the repository's plugins view
                    Rectangle {
                        horizontal-stretch: 1;
                        min-height: 62px;
                        background: transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Open " + repository.name;
                        accessible-action-default => { RepoList.open(repository.url); }

                        open-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { RepoList.open(repository.url); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 10px;
                                background: open-touch.has-hover ? Theme.accent-soft : #ffffff0c;
                                border-width: 1px;
                                border-color: open-touch.has-hover ? Theme.accent-border : #ffffff12;
                                animate background, border-color { duration: 120ms; }
                                TvIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.link;
                                    size: 16px;
                                    color: open-touch.has-hover ? Theme.accent-hi : Theme.muted;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;
                                Text {
                                    text: repository.name;
                                    color: Theme.text;
                                    font-size: 14.5px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                MutedLabel {
                                    text: repository.detail != "" ? repository.detail : repository.url;
                                    overflow: elide;
                                }
                            }

                            if repository.plugin-count != "": TvBadge {
                                text: repository.plugin-count;
                                tone: "accent";
                            }

                            TvIcon {
                                commands: Icons.chevron-right;
                                size: 16px;
                                color: open-touch.has-hover ? Theme.text : Theme.muted;
                            }
                        }
                    }

                    TvButton {
                        text: "Remove";
                        icon: Icons.trash;
                        kind: "ghost";
                        compact: true;
                        enabled: root.busy-text == "";
                        clicked => { root.remove-repository(repository.url); }
                    }
                }
            }
        }
    }
}

/// Drill-down page showing all plugins offered by a single clicked repository.
export component RepositoryDetailView inherits VerticalLayout {
    in property <string> busy-text: "";
    in property <bool> loading: false;
    callback remove-repository(string);
    callback install(string);

    spacing: Theme.space-3;
    alignment: start;

    // Navigation & repository header card
    Rectangle {
        background: Theme.panel-glass;
        vertical-stretch: 0;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000044;

        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;
                TvButton {
                    text: "Back to repositories";
                    icon: Icons.back;
                    kind: "secondary";
                    compact: true;
                    clicked => { RepoDetail.close(); }
                }
                Rectangle { horizontal-stretch: 1; }
                TvButton {
                    text: "Remove repository";
                    icon: Icons.trash;
                    kind: "danger";
                    compact: true;
                    enabled: root.busy-text == "";
                    clicked => { root.remove-repository(RepoDetail.open-url); }
                }
            }

            SettingDivider { }

            HorizontalLayout {
                spacing: 14px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    TvIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        commands: Icons.link;
                        size: 20px;
                        color: Theme.accent-hi;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Text {
                        text: RepoDetail.name != "" ? RepoDetail.name : "Repository";
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    MutedLabel {
                        text: RepoDetail.open-url;
                        overflow: elide;
                    }
                }
                if RepoDetail.summary != "": TvBadge {
                    text: RepoDetail.summary;
                    tone: "accent";
                }
            }
        }
    }

    PluginCatalogCard {
        title: "Repository plugins";
        subtitle: "Search, filter and install extensions from this repository";
        icon: Icons.puzzle;
        search-placeholder: "Search plugins in this repository…";
        search <=> RepoDetail.search;
        languages: RepoDetail.languages;
        language <=> RepoDetail.language;
        sorts: RepoDetail.sorts;
        sort <=> RepoDetail.sort;
        view <=> RepoDetail.view;
        count-text: RepoDetail.count-text;
        has-more: RepoDetail.has-more;
        items: RepoDetail.plugins;
        loading: root.loading;
        busy-text: root.busy-text;
        empty-text: RepoDetail.count-text == ""
            ? "This repository offers no plugins."
            : "No plugin in this repository matches that search or filter.";
        filter-changed => { RepoDetail.changed(); }
        load-more => { RepoDetail.more(); }
        install(key) => { root.install(key); }
    }
}
