import { Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { FilterChip, PosterItem } from "types.slint";
import { TvBadge, TvButton, TvSegmented, TvSelect, TvTextInput } from "controls.slint";
import { PosterGrid } from "poster.slint";
import { SectionTitle, MutedLabel, SkeletonRow } from "widgets.slint";

/// A spinner with a line of text: something is loading.
export component LoadingLine inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    alignment: start;
    cross-axis-alignment: center;
    Spinner {
        width: 18px;
        height: 18px;
        indeterminate: true;
    }
    MutedLabel {
        text: root.text;
        font-size: 13.5px;
        vertical-alignment: center;
    }
}

/// Browse's year, sort and genre filters and paging (read by the app when `changed` fires).
export global BrowseFilter {
    in property <[string]> years: ["Any year"];
    in-out property <string> year: "Any year";
    in property <[string]> sorts: ["Popular", "Rated 6+", "Rated 7+", "Rated 8+"];
    in-out property <string> sort: "Popular";
    in property <[FilterChip]> genres: [];
    in property <bool> has-more: false;
    callback changed();
    callback toggle-genre(int);
    callback more();
}

/// Frosted genre filter pill.
component GenreChip inherits Rectangle {
    in property <FilterChip> chip;
    callback clicked();

    height: 32px;
    width: genre-label.preferred-width + 24px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.chip.on ? Theme.accent-border : Theme.border;
    background: root.chip.on ? Theme.accent-soft : (genre-touch.has-hover ? #ffffff18 : #ffffff0b);
    animate background, border-color { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.chip.label;
    accessible-checked: root.chip.on;
    accessible-action-default => { root.clicked(); }

    genre-label := Text {
        text: root.chip.label;
        color: root.chip.on ? Theme.accent-hi : Theme.text-secondary;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    genre-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BrowsePage inherits VerticalLayout {
    in property <[PosterItem]> items: [];
    in property <string> kind: "movie";
    in property <bool> loading: false;
    in property <string> message: "";
    callback load-kind(string);
    in property <int> columns: 4;
    in property <int> focused-index: -1;
    callback open-at(int);

    padding: Theme.page-pad;
    padding-top: Theme.space-3;
    spacing: 14px;
    accessible-role: AccessibleRole.main;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        cross-axis-alignment: center;
        SectionTitle {
            text: "Browse";
            vertical-alignment: center;
        }
        Rectangle { width: 8px; }
        TvSegmented {
            model: ["Movies", "TV shows"];
            current-value: root.kind == "tv" ? "TV shows" : "Movies";
            selected(choice) => { root.load-kind(choice == "TV shows" ? "tv" : "movie"); }
        }
        Rectangle { width: 6px; }
        TvSelect {
            width: 152px;
            model: BrowseFilter.years;
            current-value <=> BrowseFilter.year;
            selected => { BrowseFilter.changed(); }
        }
        TvSelect {
            width: 156px;
            model: BrowseFilter.sorts;
            current-value <=> BrowseFilter.sort;
            selected => { BrowseFilter.changed(); }
        }
    }

    if BrowseFilter.genres.length > 0: Flickable {
        height: 36px;
        content-width: genre-row.preferred-width;
        genre-row := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for chip[i] in BrowseFilter.genres: GenreChip {
                chip: chip;
                clicked => { BrowseFilter.toggle-genre(i); }
            }
        }
    }

    MutedLabel {
        text: (BrowseFilter.sort == "Popular" ? "Popular" : "Best rated") + " on TMDB · pick any title to match it on your providers.";
        font-size: 13px;
    }
    if root.loading: LoadingLine { text: "Loading titles…"; }
    if root.loading && root.items.length == 0: SkeletonRow { count: root.columns; }
    if !root.loading && root.message != "": MutedLabel { text: root.message; font-size: 13.5px; }
    PosterGrid {
        vertical-stretch: 1;
        items: root.items;
        columns: root.columns;
        focused-index: root.focused-index;
        open-at(i) => { root.open-at(i); }
        play-at(i) => { root.open-at(i); }
        bookmark-at(i) => { root.open-at(i); }
    }
    if BrowseFilter.has-more && !root.loading: HorizontalLayout {
        alignment: center;
        padding-top: 4px;
        TvButton {
            text: "Load more";
            kind: "secondary";
            clicked => { BrowseFilter.more(); }
        }
    }
}

export component SearchPage inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[PosterItem]> items: [];
    in property <bool> loading: false;
    in property <string> message: "";
    /// The remote's focus is on the search box (Enter starts typing).
    in property <bool> search-focused: false;
    /// Raised by the app to put the keyboard into the search box.
    in property <int> box-request: 0;
    changed box-request => { search-box.focus(); }
    callback search(string);
    in property <int> columns: 4;
    in property <int> focused-index: -1;
    callback open-at(int);

    padding: Theme.page-pad;
    padding-top: Theme.space-3;
    spacing: 16px;
    accessible-role: AccessibleRole.search;

    SectionTitle { text: "Search"; }

    /// Puts the keyboard into the search box.
    public function focus-box() {
        search-box.focus();
    }

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;
        search-box := TvTextInput {
            text <=> root.query;
            placeholder-text: "Search movies, series, and anime across your providers…";
            leading-icon: Icons.search;
            focused-ring: root.search-focused;
            horizontal-stretch: 1;
            accepted => { root.search(root.query); }
        }
        TvButton {
            text: root.loading ? "Searching…" : "Search";
            icon: Icons.search;
            kind: "primary";
            enabled: !root.loading;
            clicked => { root.search(root.query); }
        }
    }

    if root.loading: LoadingLine { text: "Searching your providers for “" + root.query + "”…"; }
    if root.loading && root.items.length == 0: SkeletonRow { count: root.columns; }
    if !root.loading && root.message != "": MutedLabel { text: root.message; font-size: 13.5px; }
    PosterGrid {
        vertical-stretch: 1;
        items: root.items;
        columns: root.columns;
        focused-index: root.focused-index;
        open-at(i) => { root.open-at(i); }
        play-at(i) => { root.open-at(i); }
        bookmark-at(i) => { root.open-at(i); }
    }
}

export component LibraryPage inherits VerticalLayout {
    in property <[PosterItem]> items: [];
    in property <int> columns: 4;
    in property <int> focused-index: -1;
    callback open-at(int);
    callback remove-at(int);

    padding: Theme.page-pad;
    padding-top: Theme.space-3;
    spacing: 12px;
    accessible-role: AccessibleRole.main;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        cross-axis-alignment: center;
        SectionTitle { text: "Library"; }
        if root.items.length > 0: TvBadge {
            text: root.items.length + " saved";
            tone: "accent";
        }
    }
    MutedLabel {
        text: root.items.length == 0
            ? "Titles you save with “Library” on their details page appear here."
            : "Right-click or press Delete on a focused title to remove it from your library.";
        font-size: 13px;
    }
    PosterGrid {
        vertical-stretch: 1;
        items: root.items;
        columns: root.columns;
        focused-index: root.focused-index;
        remove-text: "Remove from Library";
        open-at(i) => { root.open-at(i); }
        play-at(i) => { root.open-at(i); }
        remove-at(i) => { root.remove-at(i); }
    }
}
