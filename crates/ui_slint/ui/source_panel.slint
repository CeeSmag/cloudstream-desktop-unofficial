import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FilterChip, SourceItem, SourceMenuInfo } from "types.slint";

/// A small rounded label (the kind of stream, "checking…", a subtitle language).
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink: #d4d8e1;
    in property <color> fill: #ffffff1a;
    height: 20px;
    width: label.preferred-width + 12px;
    border-radius: 5px;
    background: root.fill;
    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// One toggle of a filter row.
component ChipButton inherits Rectangle {
    in property <FilterChip> chip;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 22px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.chip.on ? Theme.accent : #ffffff1f;
    background: root.chip.on ? #5b8cff33 : (touch.has-hover ? #ffffff1f : #ffffff0d);
    opacity: !root.chip.on && root.chip.count == "0" ? 0.45 : 1;
    accessible-role: AccessibleRole.button;
    accessible-label: root.chip.label;
    accessible-checked: root.chip.on;
    label := Text {
        text: root.chip.count == "" ? root.chip.label : root.chip.label + "  " + root.chip.count;
        color: root.chip.on ? Theme.accent : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A heading with "shown of total", a row of toggles and a hint when nothing matches.
component FilterRow inherits VerticalLayout {
    in property <string> title;
    in property <[FilterChip]> chips;
    in property <int> shown;
    in property <int> total;
    in property <string> empty-hint;
    callback toggled(int);
    spacing: 6px;
    HorizontalLayout {
        Text {
            text: root.title;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-stretch: 1;
        }
        Text { text: root.shown + " of " + root.total; color: Theme.muted; font-size: 11px; }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for chip[i] in root.chips: ChipButton {
            chip: chip;
            clicked => { root.toggled(i); }
        }
    }
    if root.shown == 0 && root.total > 0: Text {
        text: root.empty-hint;
        color: Theme.muted;
        font-size: 11px;
        wrap: word-wrap;
    }
}

/// One stream: full name, tags, subtitle languages, size; the playing one is marked.
component SourceRow inherits Rectangle {
    in property <SourceItem> source;
    callback clicked();
    min-height: body.preferred-height + 16px;
    border-radius: Theme.radius-sm;
    background: root.source.selected ? #5b8cff26 : (touch.has-hover ? #ffffff12 : transparent);
    accessible-role: AccessibleRole.button;
    accessible-label: root.source.label;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 10px;
        body := VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            Text {
                text: root.source.label;
                color: root.source.selected ? Theme.accent : Theme.text;
                font-size: 13px;
                font-weight: root.source.selected ? 700 : 500;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if root.source.kind != "": Tag { text: root.source.kind; }
                if root.source.checking: Tag { text: "checking…"; ink: Theme.muted; }
                for flag in root.source.flags: Tag { text: flag; ink: Theme.text; fill: #ffffff26; }
            }
        }
        VerticalLayout {
            alignment: start;
            spacing: 6px;
            if root.source.size != "": Tag {
                text: root.source.size;
                ink: Theme.accent;
                fill: #5b8cff1f;
            }
            if root.source.selected: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
    }
}

/// The player's Sources menu: Refresh, the resolution and subtitle filters, then the streams.
export component SourcePanel inherits Rectangle {
    in property <[SourceItem]> sources;
    in property <SourceMenuInfo> info;
    in property <bool> can-refresh;
    callback refresh();
    callback pick(int);
    callback toggle-tier(int);
    callback toggle-subtitle(int);

    width: 420px;
    background: #141824f5;
    border-radius: Theme.radius;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;
    // Clicks on the panel never reach the video under it.
    TouchArea { }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Sources";
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.sources.length + " of " + root.info.total;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            refresh := Rectangle {
                height: 32px;
                width: refresh-label.preferred-width + 24px;
                border-radius: 8px;
                background: refresh-touch.has-hover && root.can-refresh ? #ffffff26 : #ffffff14;
                opacity: root.can-refresh ? 1 : 0.4;
                accessible-role: AccessibleRole.button;
                accessible-label: "Refresh sources";
                refresh-label := Text {
                    text: "⟳  Refresh";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                refresh-touch := TouchArea {
                    enabled: root.can-refresh;
                    mouse-cursor: root.can-refresh ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.refresh(); }
                }
            }
        }
        FilterRow {
            title: "RESOLUTION";
            chips: root.info.tiers;
            shown: root.info.resolution-shown;
            total: root.info.total;
            empty-hint: "No source has this resolution yet. Sources still being checked show up here once they are.";
            toggled(i) => { root.toggle-tier(i); }
        }
        if root.info.subtitles.length > 0: FilterRow {
            title: "ONLY WITH SUBTITLES";
            chips: root.info.subtitles;
            shown: root.info.subtitle-shown;
            total: root.info.total;
            empty-hint: "No source has these subtitles yet. Sources still being checked show up here once they are.";
            toggled(i) => { root.toggle-subtitle(i); }
        }
        Rectangle { height: 1px; background: #ffffff14; }
        if root.sources.length == 0: Text {
            text: root.info.total == 0 ? "Looking for sources…" : "No source matches these filters.";
            color: Theme.muted;
            font-size: 13px;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                for source in root.sources: SourceRow {
                    source: source;
                    clicked => { root.pick(source.index); }
                }
            }
        }
    }
}
