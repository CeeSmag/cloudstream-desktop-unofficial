import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { FilterChip, SourceItem, SourceMenuInfo } from "types.slint";
import { TvBadge, TvButton, TvProgressBar } from "controls.slint";

/// Small rounded metadata tag (stream kind, checking state, subtitle language, file size).
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-secondary;
    in property <color> fill: #ffffff18;

    height: 21px;
    width: label.preferred-width + 14px;
    border-radius: 6px;
    background: root.fill;
    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// One toggle pill of a filter row.
component ChipButton inherits Rectangle {
    in property <FilterChip> chip;
    callback clicked();

    height: 31px;
    width: label.preferred-width + 24px;
    border-radius: 15.5px;
    border-width: 1px;
    border-color: root.chip.on ? Theme.accent-border : Theme.border;
    background: root.chip.on ? Theme.accent-soft : (touch.has-hover ? #ffffff1c : #ffffff0b);
    opacity: !root.chip.on && root.chip.count == "0" ? 0.45 : 1;
    animate background, border-color { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.chip.label;
    accessible-checked: root.chip.on;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.chip.count == "" ? root.chip.label : root.chip.label + "  " + root.chip.count;
        color: root.chip.on ? Theme.accent-hi : Theme.text;
        font-size: 12.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A heading with "shown of total", a row of toggles, and a hint when nothing matches.
component FilterRow inherits VerticalLayout {
    in property <string> title;
    in property <[FilterChip]> chips;
    in property <int> shown;
    in property <int> total;
    in property <string> empty-hint;
    callback toggled(int);

    spacing: 7px;
    HorizontalLayout {
        Text {
            text: root.title;
            color: Theme.muted;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            horizontal-stretch: 1;
        }
        Text {
            text: root.shown + " of " + root.total;
            color: Theme.muted;
            font-size: 11px;
        }
    }
    HorizontalLayout {
        spacing: 7px;
        alignment: start;
        for chip[i] in root.chips: ChipButton {
            chip: chip;
            clicked => { root.toggled(i); }
        }
    }
    if root.shown == 0 && root.total > 0: Text {
        text: root.empty-hint;
        color: Theme.muted;
        font-size: 11.5px;
        wrap: word-wrap;
    }
}

/// One stream row: full name, tags, subtitle languages, size; the playing one is marked.
component SourceRow inherits Rectangle {
    in property <SourceItem> source;
    callback clicked();

    min-height: body.preferred-height + 18px;
    border-radius: 10px;
    background: root.source.selected ? Theme.accent-soft : (touch.has-hover ? #ffffff12 : #ffffff05);
    border-width: 1px;
    border-color: root.source.selected ? Theme.accent-border : #ffffff0c;
    animate background, border-color { duration: 110ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.source.label;
    accessible-action-default => { root.clicked(); }

    if root.source.selected: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 24px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 10px;
        body := VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.source.label;
                color: root.source.selected ? Theme.accent-hi : Theme.text;
                font-size: 13px;
                font-weight: root.source.selected ? 700 : 500;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                if root.source.kind != "": Tag { text: root.source.kind; }
                if root.source.working && !root.source.checking: Tag {
                    text: "verified";
                    ink: Theme.ok;
                    fill: Theme.ok-soft;
                }
                if root.source.checking: Tag { text: "checking…"; ink: Theme.muted; }
                for flag in root.source.flags: Tag { text: flag; ink: Theme.text; fill: #ffffff24; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            if root.source.size != "": Tag {
                text: root.source.size;
                ink: Theme.accent-hi;
                fill: Theme.accent-soft;
            }
            if root.source.selected: HorizontalLayout {
                alignment: center;
                TvIcon {
                    commands: Icons.check;
                    size: 15px;
                    color: Theme.accent-hi;
                }
            }
        }
    }
}

/// The player's obsidian glass Sources drawer: Refresh, resolution & subtitle filters, then streams.
export component SourcePanel inherits Rectangle {
    in property <[SourceItem]> sources;
    in property <SourceMenuInfo> info;
    in property <bool> can-refresh;
    in property <bool> loading: false;
    in property <string> loading-text: "";
    callback refresh();
    callback pick(int);
    callback toggle-tier(int);
    callback toggle-subtitle(int);
    callback close();

    width: 432px;
    background: #0b101cd0;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: #ffffff22;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;
    // Blocks clicks and wheel events from leaking to the video surface underneath.
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent-border;
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: Icons.layers;
                    size: 15px;
                    color: Theme.accent-hi;
                }
            }
            Text {
                text: "Sources";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            TvBadge {
                text: root.sources.length + " of " + root.info.total;
                tone: "neutral";
            }
            TvButton {
                text: root.loading ? "Refreshing…" : "Refresh";
                icon: Icons.refresh;
                kind: "secondary";
                compact: true;
                enabled: root.can-refresh;
                clicked => { root.refresh(); }
            }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: close-touch.has-hover ? #ffffff18 : transparent;
                animate background { duration: 110ms; }
                accessible-role: AccessibleRole.button;
                accessible-label: "Close Sources";
                accessible-action-default => { root.close(); }
                TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: Icons.close;
                    size: 14px;
                    color: close-touch.has-hover ? Theme.text : Theme.muted;
                }
                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }
        if root.loading: VerticalLayout {
            spacing: 5px;
            Text {
                text: root.loading-text != "" ? root.loading-text : "Loading sources…";
                color: Theme.accent-hi;
                font-size: 11.5px;
                font-weight: 600;
            }
            TvProgressBar {
                bar-height: 3px;
                indeterminate: true;
                fill: Theme.accent;
            }
        }
        FilterRow {
            title: "RESOLUTION";
            chips: root.info.tiers;
            shown: root.info.resolution-shown;
            total: root.info.total;
            empty-hint: "No source has this resolution yet. Sources still being checked appear here once verified.";
            toggled(i) => { root.toggle-tier(i); }
        }
        if root.info.subtitles.length > 0: FilterRow {
            title: "ONLY WITH SUBTITLES";
            chips: root.info.subtitles;
            shown: root.info.subtitle-shown;
            total: root.info.total;
            empty-hint: "No source has these subtitles yet. Sources still being checked appear here once verified.";
            toggled(i) => { root.toggle-subtitle(i); }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        if root.sources.length == 0: Text {
            text: root.info.total == 0 ? "Looking for sources…" : "No source matches these filters.";
            color: Theme.muted;
            font-size: 13px;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for source in root.sources: SourceRow {
                    source: source;
                    clicked => { root.pick(source.index); }
                }
            }
        }
    }
}
