import { Theme } from "theme.slint";

/// Floating obsidian glass notification pill at the bottom of the screen.
export component Toast inherits Rectangle {
    in property <string> text;
    /// The size of the area the toast sits in.
    in property <length> area-width;
    in property <length> area-height;
    callback dismissed();

    width: min(root.area-width - 2 * Theme.page-pad, label.preferred-width + 64px);
    height: max(48px, label.preferred-height + 24px);
    x: (root.area-width - self.width) / 2;
    y: root.area-height - self.height - 32px;
    border-radius: 24px;
    background: Theme.panel-glass;
    border-width: 1px;
    border-color: Theme.border-hi;
    drop-shadow-blur: 28px;
    drop-shadow-color: #000000b8;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 22px;
        spacing: 10px;
        alignment: center;
        cross-axis-alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
        }
        label := Text {
            text: root.text;
            color: Theme.text;
            font-size: 13.5px;
            font-weight: 500;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.dismissed(); }
    }
    changed text => { hide.restart(); }
    hide := Timer {
        interval: 5s;
        running: true;
        triggered => { root.dismissed(); }
    }
}
