import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { TvBadge, TvButton, TvProgressBar, TvSegmented, TvSelect, TvSwitch } from "controls.slint";
import { Card, MutedLabel, SectionTitle, SettingDivider, SettingRow } from "widgets.slint";

/// Settings > General: video cache, disk storage, plugin workers, diagnostics, updates & wipe.
export component SettingsGeneralPage inherits VerticalLayout {
    in property <[string]> cache-size-labels: [];
    in property <string> cache-size-value: "";
    in property <[string]> ahead-labels: [];
    in property <string> ahead-value: "";
    in property <[string]> storage-labels: [];
    in property <string> storage-value: "";
    in property <float> storage-fraction: 0;
    in property <bool> storage-over: false;
    in property <[string]> storage-rows: [];
    in property <string> storage-label: "";
    in property <[string]> worker-labels: [];
    in property <string> worker-value: "";
    in property <[string]> helper-idle-labels: [];
    in property <string> helper-idle-value: "";
    in property <[string]> helper-windows-labels: [];
    in property <string> helper-windows-value: "";
    in property <[string]> video-renderer-labels: [];
    in property <string> video-renderer-value: "";
    in property <[string]> perf-profile-labels: [];
    in property <string> perf-profile-value: "";
    in property <string> perf-pc-text: "";
    in property <string> perf-state-text: "";
    in property <string> perf-warning: "";
    in property <bool> perf-can-reset: false;
    in property <bool> debug-logging: false;
    in property <string> update-label: "";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <bool> update-can-apply: false;
    in property <bool> update-busy: false;
    in property <bool> update-downloading: false;
    in property <float> update-progress: 0;
    /// Vertical offset of the Diagnostics card inside this page (for jump-to-diagnostics scrolling).
    out property <length> diagnostics-y: diagnostics-card.y;
    /// Vertical offset of the App updates card inside this page (for jump-to-updates scrolling).
    out property <length> updates-y: updates-card.y;

    callback set-video-cache(string);
    callback set-ahead(string);
    callback set-storage-cap(string);
    callback set-worker-limit(string);
    callback set-helper-idle(string);
    callback set-helper-windows(string);
    callback set-video-renderer(string);
    callback set-performance-profile(string);
    callback reset-performance();
    callback clean-storage();
    callback set-debug-logging(bool);
    callback open-logs();
    callback check-updates();
    callback apply-update();
    callback wipe-data();

    spacing: Theme.space-3;
    alignment: start;

    VerticalLayout {
        spacing: 4px;
        SectionTitle { text: "General"; }
        MutedLabel {
            text: "Playback buffering, local disk limits, plugin runtime processes, diagnostics, and updates.";
            font-size: 13.5px;
            wrap: word-wrap;
        }
    }

    Card {
        title: "Performance & memory";
        subtitle: "Match CloudStream to this PC: plugin processes, video cache and storage";
        icon: Icons.cpu;
        warn: root.perf-warning != "";

        VerticalLayout {
            spacing: 6px;
            MutedLabel {
                text: root.perf-pc-text;
                font-size: 13px;
                wrap: word-wrap;
            }
            SettingRow {
                label: "Profile";
                description: root.perf-state-text;
                TvSelect {
                    width: 190px;
                    model: root.perf-profile-labels;
                    current-value: root.perf-profile-value;
                    selected(value) => { root.set-performance-profile(value); }
                }
            }
            if root.perf-warning != "": Text {
                text: root.perf-warning;
                color: Theme.warn;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                TvButton {
                    text: "Reset to recommended";
                    compact: true;
                    enabled: root.perf-can-reset;
                    clicked => { root.reset-performance(); }
                }
            }
        }
    }

    Card {
        title: "Video cache";
        subtitle: "Tune how much of the stream is buffered in RAM while watching";
        icon: Icons.tv;

        VerticalLayout {
            spacing: 4px;
            SettingRow {
                label: "Buffer size";
                description: "Total memory reserved for the active video stream";
                TvSelect {
                    width: 170px;
                    model: root.cache-size-labels;
                    current-value: root.cache-size-value;
                    selected(value) => { root.set-video-cache(value); }
                }
            }
            SettingDivider { }
            SettingRow {
                label: "Video output";
                description: "GPU draws straight into the window, with no picture copies (tested on Linux); takes effect after restart";
                TvSelect {
                    width: 230px;
                    model: root.video-renderer-labels;
                    current-value: root.video-renderer-value;
                    selected(value) => { root.set-video-renderer(value); }
                }
            }
            SettingDivider { }
            SettingRow {
                label: "Read-ahead share";
                description: "Portion of the buffer kept ahead of the current timestamp";
                TvSelect {
                    width: 170px;
                    model: root.ahead-labels;
                    current-value: root.ahead-value;
                    selected(value) => { root.set-ahead(value); }
                }
            }
        }
    }

    Card {
        title: "Storage";
        subtitle: "Cached posters, subtitles, saved sources, and logs on disk";
        icon: Icons.hard-drive;

        VerticalLayout {
            spacing: 12px;
            SettingRow {
                label: "Storage limit";
                description: "Soft cap before CloudStream flags usage for cleanup";
                TvSelect {
                    width: 170px;
                    model: root.storage-labels;
                    current-value: root.storage-value;
                    selected(value) => { root.set-storage-cap(value); }
                }
            }

            Rectangle {
                border-radius: Theme.radius;
                background: Theme.input-bg;
                border-width: 1px;
                border-color: root.storage-over ? Theme.danger-border : Theme.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Text {
                            text: root.storage-label;
                            color: root.storage-over ? Theme.danger : Theme.text;
                            font-size: 13.5px;
                            font-weight: 600;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        if root.storage-over: TvBadge {
                            text: "Over limit";
                            tone: "danger";
                        }
                    }
                    TvProgressBar {
                        progress: root.storage-fraction;
                        fill: root.storage-over ? Theme.danger : Theme.accent;
                        bar-height: 8px;
                    }
                    if root.storage-rows.length > 0: VerticalLayout {
                        spacing: 4px;
                        padding-top: 2px;
                        for line in root.storage-rows: HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.accent;
                            }
                            Text {
                                text: line;
                                color: Theme.muted;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                TvButton {
                    text: "Clean up storage now";
                    icon: Icons.trash;
                    kind: "secondary";
                    clicked => { root.clean-storage(); }
                }
            }
        }
    }

    Card {
        title: "Plugin processes";
        subtitle: "Each extension runs in an isolated background runtime";
        icon: Icons.cpu;

        VerticalLayout {
            spacing: 4px;
            SettingRow {
                label: "Resident workers";
                description: "More resident workers speed up switching providers at the cost of extra RAM";
                TvSegmented {
                    model: root.worker-labels;
                    current-value: root.worker-value;
                    selected(value) => { root.set-worker-limit(value); }
                }
            }
            SettingDivider { }
            SettingRow {
                label: "Close the verification helper when idle";
                description: "The Cloudflare check runs in a browser engine (100-300 MB); it starts again at the next check";
                TvSelect {
                    width: 170px;
                    model: root.helper-idle-labels;
                    current-value: root.helper-idle-value;
                    selected(value) => { root.set-helper-idle(value); }
                }
            }
            SettingDivider { }
            SettingRow {
                label: "Verified browser windows kept";
                description: "Each verified site keeps a browser window of about 150 MB; the oldest unused ones are closed. Applies the next time the helper starts";
                TvSelect {
                    width: 170px;
                    model: root.helper-windows-labels;
                    current-value: root.helper-windows-value;
                    selected(value) => { root.set-helper-windows(value); }
                }
            }
        }
    }

    diagnostics-card := Card {
        title: "Diagnostics";
        subtitle: "Detailed JSONL traces for troubleshooting UI, player, streams, plugins, and storage";
        icon: Icons.terminal;
        warn: root.debug-logging;

        VerticalLayout {
            spacing: 10px;
            SettingRow {
                label: "Write detailed debug logs";
                description: "Records step-by-step traces to logs/debug/*.jsonl (including mpv & sidecars). Uses extra CPU/disk I/O and files grow quickly; leave off normally.";
                TvSwitch {
                    checked: root.debug-logging;
                    toggled => { root.set-debug-logging(self.checked); }
                }
            }
            SettingDivider { }
            HorizontalLayout {
                padding-left: 8px;
                padding-top: 4px;
                alignment: start;
                TvButton {
                    text: "Open logs folder";
                    icon: Icons.folder;
                    kind: "secondary";
                    clicked => { root.open-logs(); }
                }
            }
        }
    }

    updates-card := Card {
        title: "App updates";
        subtitle: root.update-label;
        icon: Icons.download;

        VerticalLayout {
            spacing: 10px;
            if root.update-version != "": HorizontalLayout {
                spacing: 8px;
                alignment: start;
                TvBadge {
                    text: root.update-version;
                    tone: "accent";
                }
            }
            if root.update-notes != "": Rectangle {
                height: min(notes-text.preferred-height + 24px, 160px);
                border-radius: 10px;
                background: Theme.input-bg;
                border-width: 1px;
                border-color: Theme.border;
                ScrollView {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    notes-text := Text {
                        width: parent.width - 8px;
                        text: root.update-notes;
                        color: Theme.text-secondary;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                }
            }
            if root.update-downloading: TvProgressBar {
                progress: root.update-progress;
                fill: Theme.accent;
                bar-height: 8px;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                TvButton {
                    text: "Check for updates";
                    icon: Icons.refresh;
                    kind: "secondary";
                    enabled: !root.update-busy;
                    clicked => { root.check-updates(); }
                }
                TvButton {
                    text: root.update-downloading ? "Updating…" : "Update & restart";
                    icon: Icons.download;
                    kind: root.update-can-apply ? "primary" : "tonal";
                    enabled: root.update-can-apply && !root.update-busy;
                    clicked => { root.apply-update(); }
                }
            }
        }
    }

    Card {
        title: "Danger zone";
        subtitle: "Reset CloudStream to a clean state on the next launch";
        icon: Icons.alert;
        danger: true;

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;
            Text {
                text: "Removes installed plugins, repositories, settings, library bookmarks, and watch history.";
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            TvButton {
                text: "Delete all saved data";
                icon: Icons.trash;
                kind: "danger";
                clicked => { root.wipe-data(); }
            }
        }
    }
}
