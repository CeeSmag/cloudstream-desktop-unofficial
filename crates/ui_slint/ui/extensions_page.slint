import { Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { AvailablePlugin, PluginItem, RepositoryItem } from "types.slint";
import { TvBadge } from "controls.slint";
import { MutedLabel, SectionTitle } from "widgets.slint";
import { PluginsTab } from "extensions_plugins.slint";
import { RepoDetail, RepoList, RepositoriesTab, RepositoryDetailView } from "extensions_repos.slint";

/// One pill in the Extensions sub-navigation bar (Repositories | Plugins).
component ExtensionsNavPill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <int> count: 0;
    in property <bool> active: false;
    callback clicked();

    height: 40px;
    min-width: row.preferred-width + 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : (touch.has-hover ? #ffffff12 : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.accent-border : transparent;
    animate background, border-color { duration: 130ms; }
    accessible-role: AccessibleRole.tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;
        TvIcon {
            commands: root.icon;
            size: 16px;
            color: root.active ? Theme.accent-hi : Theme.muted;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : (touch.has-hover ? Theme.text : Theme.text-secondary);
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
        if root.count > 0: TvBadge {
            text: "\{root.count}";
            tone: root.active ? "accent" : "neutral";
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Settings > Extensions: split into Repositories (with per-repo plugin drill-down) and Plugins tabs.
export component ExtensionsPage inherits VerticalLayout {
    /// 0 = Repositories, 1 = Plugins.
    in-out property <int> active-tab: 0;
    in property <[RepositoryItem]> repositories: [];
    in property <[AvailablePlugin]> available: [];
    in property <[PluginItem]> plugins: [];
    in property <string> busy-text: "";
    in property <bool> loading: false;
    in-out property <string> repo-url: "";
    callback add-repository(string);
    callback remove-repository(string);
    callback install(string);
    callback set-trusted(string, bool);
    callback uninstall(string);

    spacing: Theme.space-3;
    alignment: start;

    HorizontalLayout {
        spacing: 16px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            SectionTitle { text: "Extensions"; }
            MutedLabel {
                text: "Subscribe to repositories, browse providers, and manage installed plugins.";
                font-size: 13.5px;
                wrap: word-wrap;
            }
        }

        // Frosted two-tab nav strip: Repositories | Plugins
        Rectangle {
            height: 48px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            border-radius: 16px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                ExtensionsNavPill {
                    label: "Repositories";
                    icon: Icons.link;
                    count: RepoList.total-count;
                    active: root.active-tab == 0;
                    clicked => {
                        root.active-tab = 0;
                        if RepoDetail.open-url != "" {
                            RepoDetail.close();
                        }
                    }
                }
                ExtensionsNavPill {
                    label: "Plugins";
                    icon: Icons.puzzle;
                    count: root.plugins.length;
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
            }
        }
    }

    if root.busy-text != "": Rectangle {
        height: 46px;
        border-radius: Theme.radius;
        background: Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent-border;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;
            cross-axis-alignment: center;
            Spinner {
                width: 18px;
                height: 18px;
                indeterminate: true;
            }
            Text {
                text: root.busy-text;
                color: Theme.accent-hi;
                font-size: 13.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    if root.active-tab == 0 && RepoDetail.open-url == "": RepositoriesTab {
        repositories: root.repositories;
        busy-text: root.busy-text;
        repo-url <=> root.repo-url;
        add-repository(url) => { root.add-repository(url); }
        remove-repository(url) => { root.remove-repository(url); }
    }

    if root.active-tab == 0 && RepoDetail.open-url != "": RepositoryDetailView {
        busy-text: root.busy-text;
        loading: root.loading;
        remove-repository(url) => { root.remove-repository(url); }
        install(key) => { root.install(key); }
    }

    if root.active-tab == 1: PluginsTab {
        plugins: root.plugins;
        available: root.available;
        total-repositories: RepoList.total-count;
        busy-text: root.busy-text;
        loading: root.loading;
        install(key) => { root.install(key); }
        set-trusted(file, on) => { root.set-trusted(file, on); }
        uninstall(file) => { root.uninstall(file); }
    }
}
