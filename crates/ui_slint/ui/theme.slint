export global Theme {
    out property <color> bg: #0c0f17;
    out property <color> panel: #141824;
    out property <color> panel-hi: #1c2233;
    out property <color> text: #f2f4f8;
    out property <color> muted: #9aa3b5;
    out property <color> accent: #5b8cff;
    out property <color> danger: #e85d6a;
    out property <color> ok: #3ecf8e;
    out property <length> radius: 10px;
}
