import { ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { EpisodeItem } from "types.slint";
import { TvBadge, TvProgressBar } from "controls.slint";
import { MutedLabel, PillButton } from "widgets.slint";

/// Season selector pill.
component SeasonChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> focused;
    callback clicked();

    height: 36px;
    width: label.preferred-width + 30px;
    border-radius: 18px;
    background: root.selected ? #f4f6fb : (touch.has-hover ? #ffffff22 : #ffffff10);
    border-width: root.focused ? 2.5px : (root.selected ? 0px : 1px);
    border-color: root.focused ? Theme.focus-ring : Theme.border;
    drop-shadow-blur: root.focused ? 14px : 0px;
    drop-shadow-color: Theme.focus-glow;
    animate background, border-color { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        color: root.selected ? Theme.bg : Theme.text;
        font-size: 13.5px;
        font-weight: root.selected ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Elevated TV episode row card.
component EpisodeRow inherits Rectangle {
    in property <EpisodeItem> episode;
    in property <bool> focused;
    in property <bool> resume-here;
    callback clicked();

    height: root.episode.description != "" ? 80px : 64px;
    clip: true;
    border-radius: Theme.radius;
    background: root.focused ? Theme.panel-hi : (touch.has-hover ? #ffffff12 : #ffffff08);
    border-width: root.focused ? 2.5px : 1px;
    border-color: root.focused ? Theme.focus-ring : (root.resume-here ? Theme.accent-border : #ffffff10);
    drop-shadow-blur: root.focused ? 16px : 0px;
    drop-shadow-color: Theme.focus-glow;
    animate background, border-color { duration: 130ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        cross-axis-alignment: center;

        Rectangle {
            width: max(62px, code-text.preferred-width + 18px);
            height: 30px;
            border-radius: 8px;
            background: root.resume-here ? Theme.accent-soft : #ffffff10;
            code-text := Text {
                text: root.episode.code;
                color: Theme.accent-hi;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.episode.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if root.episode.description != "": Text {
                text: root.episode.description;
                color: Theme.muted;
                font-size: 12.5px;
                overflow: elide;
            }
        }

        if root.resume-here: TvBadge { text: "Continue"; tone: "accent"; }
        if root.episode.watched: TvBadge { text: "Watched"; tone: "ok"; }
        if !root.episode.watched && root.episode.progress > 0: TvBadge {
            text: Math.round(root.episode.progress * 100) + "%";
            tone: "neutral";
        }

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: root.focused || touch.has-hover ? Theme.accent : #ffffff12;
            TvIcon {
                x: (parent.width - self.width) / 2 + 1px;
                y: (parent.height - self.height) / 2;
                commands: Icons.play;
                filled: true;
                size: 14px;
                color: root.focused || touch.has-hover ? Theme.bg : Theme.text;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if !root.episode.watched && root.episode.progress > 0: Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width * clamp(root.episode.progress, 0, 1);
        height: 3px;
        background: Theme.accent;
    }
}

/// Full-screen cinematic title details overlay.
export component DetailsOverlay inherits Rectangle {
    in property <string> title: "";
    in property <bool> loading: false;
    in property <bool> bookmarked: false;
    in property <string> plot: "";
    in property <string> meta: "";
    in property <[string]> tags: [];
    /// "Name (role)  ·  …".
    in property <string> cast: "";
    /// "Play S1 E1", or "Play" for a movie.
    in property <string> play-label: "Play";
    in property <string> resume-label: "";
    in property <string> resume-key: "";
    in property <image> poster;
    in property <bool> open-busy: false;
    in property <string> open-status: "";
    in property <string> open-title: "";
    in property <float> open-fraction: 0;
    in property <bool> can-skip-checks: false;
    in property <[EpisodeItem]> episodes: [];
    in property <[string]> season-labels: [];
    in-out property <int> season-filter: -1;
    in property <bool> focus-visible: false;
    in property <int> focus-row: 0;
    in property <int> focus-col: 0;
    callback play();
    callback resume();
    callback close();
    callback skip-checks();
    callback play-episode(int);
    callback season-chosen(string);
    callback toggle-bookmark();

    // Rows for the remote: 0 the buttons, then the seasons (when there are several), then episodes.
    out property <int> seasons-row: root.season-labels.length > 1 ? 1 : -1;
    out property <int> episodes-row: root.season-labels.length > 1 ? 2 : 1;
    // The buttons' places in row 0 (the app moves by the same rule).
    property <int> resume-index: root.resume-label != "" ? 1 : -1;
    property <int> bookmark-index: root.resume-label != "" ? 2 : 1;
    property <int> back-index: root.bookmark-index + 1;

    pure function action-focused(index: int) -> bool {
        return root.focus-visible && root.focus-row == 0 && root.focus-col == index;
    }

    background: Theme.bg;
    accessible-role: AccessibleRole.main;

    // Ambient backdrop: blurred poster with multi-stop cinema vignette
    if root.poster.width > 1: Image {
        width: 100%;
        height: 100%;
        source: root.poster;
        image-fit: cover;
        opacity: 0.34;
    }
    Rectangle {
        background: @linear-gradient(90deg, #080b12fa 0%, #080b12de 52%, #080b12a6 100%);
        backdrop-blur: 32px;
    }
    Rectangle {
        background: @linear-gradient(0deg, #080b12f2 0%, transparent 45%);
    }

    changed focus-row => {
        if root.focus-row >= root.episodes-row {
            episodes-view.content-y = clamp(
                episodes-view.visible-height / 2 - (root.focus-row - root.episodes-row) * 74px,
                min(0px, episodes-view.visible-height - episodes-view.content-height),
                0px);
        }
    }

    VerticalLayout {
        padding: Theme.page-pad;
        spacing: 22px;

        HorizontalLayout {
            spacing: 32px;
            alignment: start;

            // Floating poster cover
            Rectangle {
                width: 204px;
                height: 304px;
                border-radius: Theme.radius-lg;
                clip: true;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.border-hi;
                drop-shadow-blur: 32px;
                drop-shadow-color: #000000cc;
                if root.poster.width > 1: Image {
                    width: 100%;
                    height: 100%;
                    source: root.poster;
                    image-fit: cover;
                }
                if root.poster.width <= 1: TvIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: Icons.film;
                    size: 42px;
                    color: #ffffff30;
                }
            }

            VerticalLayout {
                spacing: 12px;
                alignment: start;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.hero-size;
                    font-weight: 800;
                    wrap: word-wrap;
                }

                if root.loading: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Spinner { width: 20px; height: 20px; indeterminate: true; }
                    MutedLabel {
                        text: root.plot == "" ? "Loading the title…" : root.plot;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }

                if !root.loading && root.meta != "": Text {
                    text: root.meta;
                    color: Theme.text-secondary;
                    font-size: 14.5px;
                    font-weight: 500;
                }

                if !root.loading && root.tags.length > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for tag in root.tags: TvBadge {
                        text: tag;
                        tone: "neutral";
                    }
                }

                if !root.loading && root.plot != "": Text {
                    text: root.plot;
                    color: Theme.text-secondary;
                    font-size: 15.5px;
                    wrap: word-wrap;
                    max-height: 110px;
                    overflow: elide;
                }

                if !root.loading && root.cast != "": Text {
                    text: "Cast · " + root.cast;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    padding-top: 6px;
                    if !root.loading: PillButton {
                        text: root.open-busy ? "Opening…" : root.play-label;
                        icon: Icons.play;
                        icon-filled: true;
                        primary: true;
                        enabled: !root.open-busy;
                        focused: root.action-focused(0);
                        clicked => { root.play(); }
                    }
                    if !root.loading && root.resume-label != "": PillButton {
                        text: root.resume-label;
                        icon: Icons.play;
                        icon-filled: true;
                        focused: root.action-focused(root.resume-index);
                        clicked => { root.resume(); }
                    }
                    if !root.loading: PillButton {
                        text: root.bookmarked ? "In library" : "Library";
                        icon: root.bookmarked ? Icons.check : Icons.plus;
                        focused: root.action-focused(root.bookmark-index);
                        clicked => { root.toggle-bookmark(); }
                    }
                    PillButton {
                        text: root.loading ? "Cancel" : "Back";
                        icon: Icons.back;
                        focused: root.action-focused(root.back-index);
                        clicked => { root.close(); }
                    }
                }

                if root.open-busy: Rectangle {
                    background: Theme.panel-glass;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 14px;
                        cross-axis-alignment: center;
                        Spinner { width: 22px; height: 22px; indeterminate: true; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: root.open-title;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            TvProgressBar {
                                progress: root.open-fraction;
                                bar-height: 6px;
                            }
                            if root.open-status != "": MutedLabel { text: root.open-status; }
                            if root.can-skip-checks: MutedLabel {
                                text: "Play now starts the best working source found so far; otherwise we finish checking and pick the best.";
                                font-size: 11.5px;
                            }
                        }
                        PillButton {
                            text: "Play now";
                            icon: Icons.play;
                            icon-filled: true;
                            enabled: root.can-skip-checks;
                            focused: root.action-focused(root.back-index + 1);
                            clicked => { root.skip-checks(); }
                        }
                    }
                }
            }
        }

        if root.season-labels.length > 1: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for label[i] in root.season-labels: SeasonChip {
                text: label;
                selected: (i == 0 && root.season-filter < 0) || label == "Season " + root.season-filter;
                focused: root.focus-visible && root.focus-row == root.seasons-row && root.focus-col == i;
                clicked => { root.season-chosen(label); }
            }
        }

        episodes-view := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                for episode[row] in root.episodes: EpisodeRow {
                    episode: episode;
                    resume-here: episode.data == root.resume-key;
                    focused: root.focus-visible && root.focus-row == root.episodes-row + row;
                    clicked => { root.play-episode(episode.index); }
                }
            }
        }
    }
}
