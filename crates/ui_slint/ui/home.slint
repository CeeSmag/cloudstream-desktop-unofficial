import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, TvIcon } from "icons.slint";
import { PosterItem, ShelfSection } from "types.slint";
import { TvBadge, TvButton } from "controls.slint";
import { PosterRow } from "poster.slint";
import { MutedLabel, PillButton, SkeletonRow } from "widgets.slint";

/// Clean shelf heading with an accent pip.
component ShelfHeader inherits HorizontalLayout {
    in property <string> title;
    spacing: 10px;
    cross-axis-alignment: center;
    Rectangle {
        width: 4px;
        height: 20px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}

/// Cinematic hero banner at the top of Home: last watched title with Resume & Details.
component Hero inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> artwork;
    in property <bool> focused;
    callback resume();
    callback info();

    border-radius: Theme.radius-lg;
    clip: true;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 28px;
    drop-shadow-color: #00000080;

    if root.artwork.width > 1: Image {
        x: parent.width * 0.28;
        width: parent.width * 0.72;
        height: 100%;
        source: root.artwork;
        image-fit: cover;
    }
    // Multi-stop cinema scrim blending artwork into obsidian background
    Rectangle {
        background: @linear-gradient(90deg, #0b101d 0%, #0b101df5 32%, #0b101d80 58%, #0b101d00 82%);
    }
    Rectangle {
        background: @linear-gradient(0deg, #080b12ee 0%, #080b1255 34%, transparent 65%);
    }
    VerticalLayout {
        padding: 36px;
        spacing: 12px;
        alignment: end;
        HorizontalLayout {
            alignment: start;
            TvBadge {
                text: "CONTINUE WATCHING";
                tone: "accent";
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.hero-size;
            font-weight: 800;
            wrap: word-wrap;
            max-width: 720px;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-secondary;
            font-size: 15.5px;
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            padding-top: 6px;
            PillButton {
                text: "Resume";
                icon: Icons.play;
                icon-filled: true;
                primary: true;
                focused: root.focused;
                clicked => { root.resume(); }
            }
            PillButton {
                text: "Details";
                icon: Icons.info;
                clicked => { root.info(); }
            }
        }
    }
}

export component HomePage inherits ScrollView {
    in property <[PosterItem]> continue-items: [];
    in property <[ShelfSection]> shelves: [];
    in property <string> provider-name: "";
    in property <bool> has-providers: false;
    in property <bool> loading: false;
    in property <string> hero-title: "";
    in property <string> hero-subtitle: "";
    in property <image> hero-image;
    in property <bool> focus-visible: false;
    in property <int> focus-row: 0;
    in property <int> focus-col: 0;
    in property <int> hero-row: -1;
    in property <int> continue-row: -1;
    /// The banner's title in the continue-watching row (-1 for no banner).
    in property <int> hero-index: -1;
    in property <int> shelf-row-base: 0;
    callback open-continue(int);
    callback open-shelf(int, int);
    callback resume-hero();
    callback play-continue(int);
    callback bookmark-continue(int);
    callback remove-continue(int);
    callback clear-continue();
    property <bool> asking-clear: false;

    accessible-role: AccessibleRole.main;

    /// The focused row's index in its row, or -1 when `row` is not focused.
    pure function focus-in(row: int) -> int {
        return root.focus-visible && root.focus-row == row ? root.focus-col : -1;
    }

    /// Scrolls so that the band at window height `top` (`height` tall) is fully visible.
    function reveal(top: length, height: length) {
        if top - root.absolute-position.y < 90px {
            root.content-y = min(0px, root.content-y + 90px - (top - root.absolute-position.y));
        } else if top - root.absolute-position.y + height > root.visible-height - 16px {
            root.content-y = max(
                root.visible-height - root.content-height,
                root.content-y - (top - root.absolute-position.y + height - root.visible-height + 16px));
        }
    }

    changed focus-row => {
        if root.focus-row < 0 || root.focus-row == root.hero-row {
            root.content-y = 0px;
        }
    }
    animate content-y { duration: 220ms; easing: ease-out; }

    VerticalLayout {
        padding: Theme.page-pad;
        padding-top: Theme.space-3;
        spacing: 28px;

        if root.hero-title != "": Hero {
            height: clamp(root.visible-height * 0.48, 300px, 440px);
            title: root.hero-title;
            subtitle: root.hero-subtitle;
            artwork: root.hero-image;
            focused: root.focus-in(root.hero-row) >= 0;
            resume => { root.resume-hero(); }
            info => { root.open-continue(root.hero-index); }
        }

        if root.continue-items.length > 0: VerticalLayout {
            spacing: 6px;
            ShelfHeader {
                title: "Continue watching";
                if root.asking-clear: Text {
                    text: "Clear watch history?";
                    color: Theme.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if root.asking-clear: TvButton {
                    text: "Yes, clear";
                    kind: "danger";
                    compact: true;
                    clicked => { root.asking-clear = false; root.clear-continue(); }
                }
                TvButton {
                    text: root.asking-clear ? "Cancel" : "Clear all";
                    kind: "ghost";
                    compact: true;
                    clicked => { root.asking-clear = !root.asking-clear; }
                }
            }
            PosterRow {
                items: root.continue-items;
                remove-text: "Remove from Continue watching";
                focused-index: root.focus-in(root.continue-row);
                focus-arrived(y, h) => { root.reveal(y, h); }
                open-at(i) => { root.open-continue(i); }
                play-at(i) => { root.play-continue(i); }
                bookmark-at(i) => { root.bookmark-continue(i); }
                remove-at(i) => { root.remove-continue(i); }
            }
        }

        if root.loading && root.shelves.length == 0: VerticalLayout {
            spacing: 12px;
            MutedLabel {
                text: "Loading " + (root.provider-name == "" ? "Home" : root.provider-name) + "…";
                font-size: 14.5px;
            }
            SkeletonRow { }
            SkeletonRow { }
        }
        if !root.loading && root.shelves.length == 0: Rectangle {
            min-height: 200px;
            border-radius: Theme.radius-lg;
            background: Theme.panel-glass;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 36px;
                spacing: 12px;
                alignment: center;
                cross-axis-alignment: center;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 16px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    TvIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        commands: root.has-providers ? Icons.film : Icons.puzzle;
                        size: 24px;
                        color: Theme.accent-hi;
                    }
                }
                Text {
                    text: root.has-providers ? "Nothing to show from " + root.provider-name + " right now." : "Welcome to CloudStream";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.has-providers ? "Switch providers in the top bar or in Settings → Preferences." : "Add a repository and install a plugin in Settings → Extensions to fill Home.";
                    color: Theme.muted;
                    font-size: 14.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        for shelf[s] in root.shelves: VerticalLayout {
            spacing: 6px;
            ShelfHeader {
                title: shelf.title;
            }
            PosterRow {
                items: shelf.items;
                focused-index: root.focus-in(root.shelf-row-base + s);
                focus-arrived(y, h) => { root.reveal(y, h); }
                open-at(i) => { root.open-shelf(s, i); }
                play-at(i) => { root.open-shelf(s, i); }
                bookmark-at(i) => { root.open-shelf(s, i); }
            }
        }
    }
}
