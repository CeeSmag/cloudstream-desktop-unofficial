{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudStream",
  "version": "0.3.5",
  "identifier": "com.cloudstream.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudStream",
        "width": 1280,
        "height": 750,
        "minWidth": 480,
        "minHeight": 360,
        "transparent": false,
        "decorations": true,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "CloudStream desktop",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
