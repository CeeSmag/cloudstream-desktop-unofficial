{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudStream",
  "version": "0.1.0",
  "identifier": "com.cloudstream.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev --prefix frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build --prefix frontend",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudStream",
        "width": 1280,
        "height": 750,
        "minWidth": 480,
        "minHeight": 360,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
